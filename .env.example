# Copy to `.env` for local development. Every variable is optional:
# each feature degrades gracefully (and silently) when its variables are missing.

# --- Site -------------------------------------------------------------------
# Canonical origin, no trailing slash. Set this once you have a custom domain.
# Fallback order: SITE_URL -> https://$VERCEL_PROJECT_PRODUCTION_URL -> http://localhost:4321
SITE_URL=

# --- Analytics (Umami, cookieless) -------------------------------------------
# Website ID from your Umami dashboard. Loaded in production only.
PUBLIC_UMAMI_WEBSITE_ID=
# Optional: script URL for self-hosted Umami. Defaults to https://cloud.umami.is/script.js
PUBLIC_UMAMI_SRC=

# --- Newsletter (Buttondown) -------------------------------------------------
# Your Buttondown username. If empty, the form is hidden in production
# and a "configure newsletter" notice is shown in development only.
PUBLIC_BUTTONDOWN_USERNAME=

# --- Search engine verification ----------------------------------------------
# Only the token value (the content="..." part of the meta tag).
PUBLIC_GSC_VERIFICATION=
PUBLIC_BING_VERIFICATION=

# --- View counter (Upstash Redis REST) ----------------------------------------
# Create a database at https://console.upstash.com or add the Upstash Redis
# integration in the Vercel dashboard. Server-side secrets: never prefix with PUBLIC_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# The Vercel marketplace integration sets these names instead; they are also accepted:
KV_REST_API_URL=
KV_REST_API_TOKEN=
