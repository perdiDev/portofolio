---
/**
 * Foundation shell (see DESIGN.md): head + SEO, theme bootstrap, sticky rail, main, footer.
 * Pages compose sections inside it and pass the rail navigation in reading order.
 */
import '../styles/fonts.css';
import '../styles/foundation/tokens.css';
import '../styles/foundation/base.css';
import '../styles/foundation/shell.css';
import '../styles/foundation/section.css';
import '../styles/foundation/motion.css';
import '../styles/foundation/transitions.css';
import { Font, getImage } from 'astro:assets';
import photo from '../assets/photo.jpeg';
import Analytics from '../components/Analytics.astro';
import SEO, { type Props as SeoProps } from '../components/SEO.astro';
import { AUTHOR, LOCAL_TIME, SITE } from '../config';

export interface NavItem {
  /** Id of a `<section>` on the page. */
  id: string;
  label: string;
}

export interface Props {
  /** Page title without the site suffix (used for <title> unless `seo.fullTitle` is set). */
  title: string;
  description: string;
  /** Text of the page's single, visually hidden `h1`. Defaults to `title`. */
  heading?: string;
  /** The page renders its own visible `h1`: skip the hidden one. */
  ownHeading?: boolean;
  /** Section anchors for the rail, in reading order. */
  nav?: readonly NavItem[];
  noindex?: boolean;
  /** Everything else SEO.astro accepts: fullTitle, canonical, type, image, article, prev, next, jsonLd. */
  seo?: Omit<SeoProps, 'title' | 'description' | 'noindex'>;
}

const {
  title,
  description,
  heading = title,
  ownHeading = false,
  nav = [],
  noindex = false,
  seo = {},
} = Astro.props;

// Browser UI colour per theme. Keep in sync with --bg in styles/foundation/tokens.css.
const THEME_COLOR = { light: '#f4f1ea', dark: '#141311' };

const portrait = await getImage({ src: photo, width: 400, format: 'webp' });
const isHome = Astro.url.pathname === '/';
const year = new Date().getFullYear();
const siteLinks = [
  { href: '/blog/', label: 'Diary' },
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
  { href: '/rss.xml', label: 'RSS' },
];
---

<!doctype html>
<html lang={SITE.language} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Theme before first paint, and the .js flag that gates every entrance animation.
      try {
        var t = localStorage.getItem('theme');
        if (t !== 'light' && t !== 'dark')
          t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      } catch (e) {}
      document.documentElement.classList.add('js');
    </script>
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={THEME_COLOR.light} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={THEME_COLOR.dark} />

    <SEO title={title} description={description} noindex={noindex} {...seo} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <Font cssVariable="--font-lora" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-inter" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-jetbrains-mono" />

    <Analytics />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <div class="progress" aria-hidden="true">
      <i id="bar"></i>
    </div>
    <div class="cursor" id="cursor" aria-hidden="true">
      View
    </div>

    <div class="shell">
      <aside class="rail">
        <div class="rail-top">
          <figure class="avatar">
            <img
              src={portrait.src}
              width={portrait.attributes.width}
              height={portrait.attributes.height}
              alt={`Portrait of ${AUTHOR.name}`}
              decoding="async"
            />
          </figure>
          <a class="brand" href="/" aria-current={isHome ? 'page' : undefined}>
            {AUTHOR.name}
          </a>
          <p class="role-line">{AUTHOR.jobTitle}</p>
        </div>

        {nav.length > 0 ? (
          <nav class="toc" aria-label="Sections">
            <ol>
              {nav.map((item, i) => (
                <li>
                  <a
                    href={`#${item.id}`}
                    data-target={item.id}
                    aria-current={i === 0 ? 'true' : undefined}
                  >
                    <span class="toc-n">{String(i + 1).padStart(2, '0')}</span>
                    <span class="toc-l">{item.label}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        ) : (
          <div />
        )}

        <div class="rail-bottom">
          <svg
            class="scrawl"
            viewBox="0 0 220 120"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              pathLength="1"
              d="M10 78 C 18 40, 34 26, 40 44 C 46 62, 24 92, 32 84 C 44 72, 52 40, 62 46 C 72 52, 56 84, 70 80 C 84 76, 86 52, 96 54 C 106 56, 96 80, 108 78 C 122 76, 124 46, 134 48 C 144 50, 134 78, 146 76 C 160 74, 160 50, 170 52 C 180 54, 172 74, 184 72 C 194 70, 198 62, 210 58"
            ></path>
            <path pathLength="1" d="M18 98 C 50 90, 84 104, 120 96 S 176 90, 206 98"></path>
            <path
              pathLength="1"
              d="M60 22 C 70 12, 82 14, 78 24 C 74 34, 62 30, 70 20 C 78 10, 96 12, 104 20"
            ></path>
            <path
              pathLength="1"
              d="M138 24 C 146 18, 156 20, 152 28 C 148 34, 140 32, 146 26 C 152 20, 166 20, 172 26"
            ></path>
          </svg>
          <div class="rail-foot">
            <p class="clock">
              <span class="dot" aria-hidden="true"></span>
              {LOCAL_TIME.city}
              <time
                id="clock"
                class="tnum"
                data-tz={LOCAL_TIME.timeZone}
                data-tz-label={LOCAL_TIME.label}
              >
                --:--
              </time>
            </p>
            <button
              id="theme"
              class="theme"
              type="button"
              aria-label="Switch to dark mode"
              aria-pressed="false"
            >
              <svg
                class="i-sun"
                viewBox="0 0 24 24"
                width="17"
                height="17"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
              </svg>
              <svg
                class="i-moon"
                viewBox="0 0 24 24"
                width="17"
                height="17"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5z"></path>
              </svg>
            </button>
          </div>
        </div>
      </aside>

      <div class="col">
        <main id="main" class="main" tabindex="-1">
          {!ownHeading && <h1 class="sr">{heading}</h1>}
          <slot />
        </main>

        <footer class="foot small">
          <span>
            © {year} {AUTHOR.name}
          </span>
          <nav class="foot-nav" aria-label="Site">
            <ul>
              {siteLinks.map((l) => (
                <li>
                  <a class="ulink" href={l.href}>
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <span>Designed and built by hand</span>
        </footer>
      </div>
    </div>

    <script>
      import '../scripts/foundation/theme';
      import '../scripts/foundation/clock';
      import '../scripts/foundation/toc';
      import '../scripts/foundation/reveal';
      import '../scripts/foundation/progress';
      import '../scripts/foundation/cursor';
      import '../scripts/foundation/transition';
    </script>
  </body>
</html>
