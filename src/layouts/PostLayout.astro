---
import type { MarkdownHeading } from 'astro';
import { getImage } from 'astro:assets';
import Post from '../components/Post.astro';
import { BLOG, OG } from '../config';
import { blogPostingJsonLd, breadcrumbJsonLd, type BreadcrumbItem } from '../utils/jsonld';
import { postUrl, readingTimeOf, type Post as PostEntry, type Project } from '../utils/posts';
import { absoluteUrl, ogImagePath } from '../utils/seo';
import FoundationLayout from './FoundationLayout.astro';

interface Props {
  post: PostEntry;
  headings: MarkdownHeading[];
  /** Older neighbour. */
  prev?: PostEntry;
  /** Newer neighbour. */
  next?: PostEntry;
  related: PostEntry[];
  project?: Project;
}

const { post, headings, prev, next, related, project } = Astro.props;
const site = Astro.site!;
const { title, description, pubDate, updatedDate, category, tags, canonicalUrl } = post.data;
const reading = readingTimeOf(post);

// Own URL by default; `canonicalUrl` for articles cross-posted from elsewhere.
const selfUrl = absoluteUrl(postUrl(post), site);
const canonical = canonicalUrl ?? selfUrl;

const overrideImage = post.data.ogImage
  ? await getImage({
      src: post.data.ogImage,
      width: OG.width,
      height: OG.height,
      format: 'jpg',
      fit: 'cover',
    })
  : undefined;
const ogImage = absoluteUrl(overrideImage?.src ?? ogImagePath('blog', post.id), site);

const crumbs: BreadcrumbItem[] = [
  { name: 'Home', href: '/' },
  { name: 'Diary', href: '/blog/' },
  { name: title, href: postUrl(post) },
];

const jsonLd = [
  blogPostingJsonLd({
    site,
    url: canonical,
    headline: title,
    description,
    image: ogImage,
    datePublished: pubDate,
    dateModified: updatedDate ?? pubDate,
    keywords: tags,
    section: category,
    wordCount: reading.words,
  }),
  breadcrumbJsonLd(site, crumbs),
];

// The rail lists the h2 headings when there are enough of them, like the old table of contents.
const sections = headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, label: h.text }));
const nav =
  headings.filter((h) => h.depth === 2 || h.depth === 3).length >= BLOG.tocMinHeadings
    ? sections
    : [];
---

<FoundationLayout
  title={title}
  description={description}
  heading={title}
  ownHeading
  nav={nav}
  seo={{
    canonical,
    type: 'article',
    image: { url: ogImage, alt: title, width: OG.width, height: OG.height },
    article: { publishedTime: pubDate, modifiedTime: updatedDate, section: category, tags },
    jsonLd,
  }}
>
  <Post post={post} prev={prev} next={next} related={related} project={project} url={canonical}>
    <slot />
  </Post>
</FoundationLayout>
