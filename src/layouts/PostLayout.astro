---
import type { MarkdownHeading } from 'astro';
import { getImage, Picture } from 'astro:assets';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Icon from '../components/Icon.astro';
import Newsletter from '../components/Newsletter.astro';
import PostNav from '../components/PostNav.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import ShareButtons from '../components/ShareButtons.astro';
import Tag from '../components/Tag.astro';
import TOC from '../components/TOC.astro';
import ViewCounter from '../components/ViewCounter.astro';
import { OG } from '../config';
import { blogPostingJsonLd, breadcrumbJsonLd, type BreadcrumbItem } from '../utils/jsonld';
import { postUrl, projectUrl, readingTimeOf, type Post, type Project } from '../utils/posts';
import { absoluteUrl, ogImagePath } from '../utils/seo';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  /** Older neighbour. */
  prev?: Post;
  /** Newer neighbour. */
  next?: Post;
  related: Post[];
  project?: Project;
}

const { post, headings, prev, next, related, project } = Astro.props;
const site = Astro.site!;
const { title, description, pubDate, updatedDate, category, tags, cover, coverAlt, canonicalUrl } =
  post.data;
const reading = readingTimeOf(post);

// Own URL by default; `canonicalUrl` for articles cross-posted from elsewhere.
const selfUrl = absoluteUrl(postUrl(post), site);
const canonical = canonicalUrl ?? selfUrl;

const overrideImage = post.data.ogImage
  ? await getImage({
      src: post.data.ogImage,
      width: OG.width,
      height: OG.height,
      format: 'jpg',
      fit: 'cover',
    })
  : undefined;
const ogImage = absoluteUrl(overrideImage?.src ?? ogImagePath('blog', post.id), site);

const crumbs: BreadcrumbItem[] = [
  { name: 'Home', href: '/' },
  { name: 'Blog', href: '/blog/' },
  { name: title, href: postUrl(post) },
];

const jsonLd = [
  blogPostingJsonLd({
    site,
    url: canonical,
    headline: title,
    description,
    image: ogImage,
    datePublished: pubDate,
    dateModified: updatedDate ?? pubDate,
    keywords: tags,
    section: category,
    wordCount: reading.words,
  }),
  breadcrumbJsonLd(site, crumbs),
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  type="article"
  image={{ url: ogImage, alt: title, width: OG.width, height: OG.height }}
  article={{ publishedTime: pubDate, modifiedTime: updatedDate, section: category, tags }}
  jsonLd={jsonLd}
>
  <div class="reading-progress" aria-hidden="true"></div>

  <div class="page page-top relative">
    <Breadcrumbs items={crumbs} class="mb-8" />

    <article
      data-pagefind-body
      data-pagefind-filter="category[data-category], type[data-type]"
      data-category={category}
      data-type="Post"
    >
      <header class="mb-10">
        <div class="meta flex flex-wrap items-center gap-x-3 gap-y-2" data-pagefind-ignore>
          <Tag name={category} kind="category" />
          <FormattedDate date={pubDate} />
          {updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <FormattedDate date={updatedDate} prefix="Updated" />
            </>
          )}
          <span aria-hidden="true">·</span>
          <span class="inline-flex items-center gap-1.5">
            <Icon name="clock" class="size-4" />
            {reading.text}
          </span>
          <ViewCounter slug={post.id} />
        </div>

        <h1 class="mt-4 text-4xl leading-[1.15] sm:text-5xl" data-pagefind-meta="title">
          {title}
        </h1>
        <p class="mt-5 font-serif text-xl leading-relaxed text-muted">{description}</p>

        {project && (
          <p class="mt-5 text-sm" data-pagefind-ignore>
            <span class="text-muted">Part of project: </span>
            <a href={projectUrl(project)} class="link-grow font-medium text-accent">
              {project.data.title}
            </a>
          </p>
        )}
      </header>

      {cover && (
        <Picture
          src={cover}
          alt={coverAlt ?? ''}
          formats={['avif', 'webp']}
          widths={[480, 728, 1100]}
          sizes="(min-width: 768px) 728px, 100vw"
          priority
          class="mb-10 h-auto w-full rounded-lg border border-border"
        />
      )}

      <TOC headings={headings} variant="details" />

      <div class="prose">
        <slot />
      </div>

      <ul class="mt-10 flex flex-wrap gap-2" aria-label="Tags" data-pagefind-ignore>
        {tags.map((tag) => (
          <li>
            <Tag name={tag} kind="tag" />
          </li>
        ))}
      </ul>
    </article>

    <TOC headings={headings} variant="aside" />

    <div class="mt-14 space-y-14 border-t border-border pt-10">
      <ShareButtons url={canonical} title={title} />
      <Newsletter id="post-newsletter" />
      <PostNav
        label="More articles"
        prev={prev ? { title: prev.data.title, href: postUrl(prev) } : undefined}
        next={next ? { title: next.data.title, href: postUrl(next) } : undefined}
        prevLabel="Previous post"
        nextLabel="Next post"
      />
      <RelatedPosts posts={related} />
    </div>
  </div>
</BaseLayout>
