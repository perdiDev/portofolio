---
/**
 * Shared shell for every paginated list of posts: the diary, category pages, tag pages.
 * Produces unique titles/descriptions ("Diary — Page 2"), self-canonicals,
 * rel prev/next and the matching breadcrumb JSON-LD. The visible page is the Diary section.
 */
import Diary from '../components/views/Diary.astro';
import { breadcrumbJsonLd, type BreadcrumbItem } from '../utils/jsonld';
import { clamp } from '../utils/format';
import { pageUrl, type Page } from '../utils/paginate';
import { pageLabel } from '../utils/seo';
import type { Post } from '../utils/posts';
import type { Term } from '../utils/taxonomy';
import FoundationLayout from './FoundationLayout.astro';

interface Props {
  /** Visible title. */
  heading: string;
  /** Short name used in <title>: "Diary", "Linux", "Tag: typescript". */
  label: string;
  intro?: string;
  /** Meta description of the first page. */
  description: string;
  /** Trail up to and including this listing's first page. */
  breadcrumbs: BreadcrumbItem[];
  /** Path of page 1, ending with "/". */
  base: string;
  page: Page<Post>;
  noindex?: boolean;
  /** Shows the topic links under the intro. */
  categories?: Term[];
  /** Name of the active category. */
  current?: string;
  /** Link back to the parent listing (category and tag pages). */
  kicker?: { label: string; href: string };
}

const {
  heading,
  label,
  intro,
  description,
  breadcrumbs,
  base,
  page,
  noindex,
  categories,
  current,
  kicker,
} = Astro.props;
const site = Astro.site!;

const trail: BreadcrumbItem[] =
  page.page > 1
    ? [...breadcrumbs, { name: `Page ${page.page}`, href: pageUrl(base, page.page) }]
    : breadcrumbs;

const pageDescription =
  page.page > 1
    ? clamp(`${label}, page ${page.page} of ${page.totalPages}. ${description}`, 160)
    : description;
---

<FoundationLayout
  title={pageLabel(label, page.page)}
  description={pageDescription}
  heading={heading}
  ownHeading
  noindex={noindex}
  seo={{ prev: page.prevUrl, next: page.nextUrl, jsonLd: [breadcrumbJsonLd(site, trail)] }}
>
  <Diary
    heading={heading}
    intro={intro}
    kicker={kicker}
    page={page}
    base={base}
    categories={categories}
    current={current}
  />
</FoundationLayout>
