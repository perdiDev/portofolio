---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/lora';
import '@fontsource-variable/lora/wght-italic.css';
import { getImage } from 'astro:assets';
import photo from '../assets/photo.jpeg';
import { ACHIEVEMENTS, AUTHOR, EXPERIENCE, SOCIALS } from '../config';
import { getProjects, projectUrl } from '../utils/posts';
import { PLATES } from '../components/new-home-4/plates';

const norm = (ym: string) => ym.replace(/-(\d)$/, '-0$1');
const fmt = (ym: string) => {
  const [y, m] = norm(ym).split('-').map(Number);
  return new Date(Date.UTC(y, m - 1, 1)).toLocaleDateString('en-US', {
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  });
};

const portrait = await getImage({ src: photo, width: 400, format: 'webp' });

const projects = await Promise.all(
  (await getProjects()).slice(0, 7).map(async (p, i) => ({
    n: String(i + 1).padStart(2, '0'),
    title: p.data.title,
    summary: p.data.summary,
    status: p.data.status,
    year: p.data.date.getUTCFullYear(),
    stack: p.data.techStack.slice(0, 5),
    more: Math.max(0, p.data.techStack.length - 5),
    href: projectUrl(p),
    plate: await (async () => {
      const pl = PLATES[p.id] ?? { hue: '#8a4a30', kind: 'browser' as const, art: '', shots: [{ src: p.data.thumbnail.image, alt: p.data.thumbnail.alt }] };
      const shots = await Promise.all(
        pl.shots.map(async (s, j) => ({
          alt: s.alt,
          img: await getImage({ src: s.src, width: pl.kind === 'phones' ? 520 : j === 0 ? 1400 : 760, format: 'webp' }),
        })),
      );
      return { ...pl, shots };
    })(),
  })),
);

const monthIndex = (ym: string) => {
  const [y, m] = norm(ym).split('-').map(Number);
  return y * 12 + (m - 1);
};
const tenure = (from: string, to: string | null) => {
  const now = new Date();
  const end = to ? monthIndex(to) : now.getUTCFullYear() * 12 + now.getUTCMonth();
  const n = Math.max(1, end - monthIndex(from) + 1);
  const y = Math.floor(n / 12);
  const m = n % 12;
  return [y && `${y} yr${y > 1 ? 's' : ''}`, m && `${m} mo${m > 1 ? 's' : ''}`].filter(Boolean).join(' ');
};

const experience = EXPERIENCE.slice(0, 5).map((e, i) => {
  const starts = e.roles.map((r) => norm(r.startDate)).sort();
  const ongoing = e.roles.some((r) => r.endDate === null);
  const ends = e.roles.map((r) => norm(r.endDate ?? '')).sort();
  return {
    id: `exp-${i}`,
    company: e.company,
    url: e.companyUrl,
    location: e.location,
    range: `${fmt(starts[0])} – ${ongoing ? 'Present' : fmt(ends[ends.length - 1])}`,
    span: tenure(starts[0], ongoing ? null : ends[ends.length - 1]),
    ongoing,
    titles: e.roles.map((r) => r.title).join(' / '),
    roles: e.roles.map((r) => ({
      title: r.title,
      meta: [r.employmentType, `${fmt(r.startDate)} – ${r.endDate ? fmt(r.endDate) : 'Present'}`]
        .filter(Boolean)
        .join(' · '),
      bullets: r.description.split('•').map((s) => s.trim()).filter(Boolean),
    })),
  };
});

const nav = [
  ['work', 'Selected work'],
  ['experience', 'Experience'],
  ['education', 'Education'],
  ['recognition', 'Recognition'],
  ['contact', 'Contact'],
] as const;

const description = `${AUTHOR.name}, ${AUTHOR.jobTitle}. ${AUTHOR.bio}`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Perdi — Software Engineer</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" />
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
        document.documentElement.classList.add('js');
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#work">Skip to content</a>
    <div class="progress" aria-hidden="true"><i id="bar"></i></div>
    <div class="cursor" id="cursor" aria-hidden="true">View</div>

    <div class="shell">
      <!-- Side rail -->
      <aside class="rail">
        <div class="rail-top">
          <figure class="avatar">
            <img src={portrait.src} width={portrait.attributes.width} height={portrait.attributes.height} alt="Portrait of Perdi" fetchpriority="high" decoding="async" />
          </figure>
          <a class="brand" href="#work">Perdi</a>
          <p class="role-line">{AUTHOR.jobTitle}</p>
        </div>

        <nav class="toc" aria-label="Sections">
          <ol>
            {nav.map(([id, label], i) => (
              <li>
                <a href={`#${id}`} data-target={id} aria-current={i === 0 ? 'true' : undefined}>
                  <span class="toc-n">{String(i + 1).padStart(2, '0')}</span>
                  <span class="toc-l">{label}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>

        <div class="rail-bottom">
        <svg class="scrawl" viewBox="0 0 220 120" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path pathLength="1" d="M10 78 C 18 40, 34 26, 40 44 C 46 62, 24 92, 32 84 C 44 72, 52 40, 62 46 C 72 52, 56 84, 70 80 C 84 76, 86 52, 96 54 C 106 56, 96 80, 108 78 C 122 76, 124 46, 134 48 C 144 50, 134 78, 146 76 C 160 74, 160 50, 170 52 C 180 54, 172 74, 184 72 C 194 70, 198 62, 210 58" />
          <path pathLength="1" d="M18 98 C 50 90, 84 104, 120 96 S 176 90, 206 98" />
          <path pathLength="1" d="M60 22 C 70 12, 82 14, 78 24 C 74 34, 62 30, 70 20 C 78 10, 96 12, 104 20" />
          <path pathLength="1" d="M138 24 C 146 18, 156 20, 152 28 C 148 34, 140 32, 146 26 C 152 20, 166 20, 172 26" />
        </svg>
        <div class="rail-foot">
          <p class="clock"><span class="dot" aria-hidden="true"></span> Makassar <time id="clock" class="tnum">--:--</time></p>
          <button id="theme" class="theme" type="button" aria-label="Switch to dark mode" aria-pressed="false">
            <svg class="i-sun" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
            </svg>
            <svg class="i-moon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5z"></path>
            </svg>
          </button>
        </div>
        </div>
      </aside>

      <main class="main">
        <!-- 02 Selected work -->
        <section id="work" class="band" aria-label="Selected work">

          <ul class="grid">
            {projects.map((p) => (
              <li class="card reveal">
                <a class="card-link" href={p.href} data-cursor>
                  <span class="card-head">
                    <span class="card-left">
                      <span class="card-title"><span class="card-no tnum">{p.n}</span>{p.title}</span>
                      <span class="card-status">{p.status} · {p.year}</span>
                    </span>
                    <span class="card-sum">{p.summary}</span>
                  </span>
                  <span class={`plate plate-${p.plate.kind}`} style={`--hue:${p.plate.hue}`}>
                    {p.plate.art && <svg class="art" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true" set:html={p.plate.art} />}
                    <span class="screens">
                      {p.plate.shots.map((s, j) => (
                        <span class={`shot shot-${j}`} style={`--j:${j}`}>
                          <img src={s.img.src} width={s.img.attributes.width} height={s.img.attributes.height} alt={s.alt} loading="lazy" decoding="async" />
                        </span>
                      ))}
                    </span>
                    {p.stack.length > 0 && (
                      <span class="dock" aria-label={`Stack: ${[...p.stack].join(', ')}${p.more ? ` and ${p.more} more` : ''}`}>
                        {p.stack.map((t, k) => <span class="dock-i" style={`--k:${k}`}>{t}</span>)}
                        {p.more > 0 && <span class="dock-i dock-more tnum" style={`--k:${p.stack.length}`}>{p.more}+</span>}
                      </span>
                    )}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>

        <!-- 03 Experience -->
        <section id="experience" class="sec" aria-labelledby="exp-h">
          <header class="sec-head reveal">
            <div>
              <p class="sec-n">02</p>
              <h2 id="exp-h">Experience</h2>
            </div>
          </header>
          <ol class="exp" id="exp-list">
            {experience.map((e, i) => (
              <li class="exp-item reveal" style={`--i:${i}`} data-open={i === 0 ? 'true' : 'false'}>
                <h3>
                  <button class="exp-btn" type="button" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={e.id}>
                    <span class="exp-when tnum">
                      <span class="exp-range">{e.ongoing && <i class="dot" aria-hidden="true"></i>}{e.range}</span>
                      <span class="exp-span">{e.span}</span>
                    </span>
                    <span class="exp-main">
                      <span class="exp-co">{e.company}</span>
                      <span class="exp-role">{e.titles}</span>
                    </span>
                    <span class="exp-icon" aria-hidden="true"></span>
                  </button>
                </h3>
                <div class="exp-panel" id={e.id} role="region">
                  <div class="exp-clip">
                    <div class="exp-body">
                      {e.location && <p class="small" style="--k:0">{e.location}</p>}
                      {e.roles.map((r, j) => (
                        <div class="exp-roleblock" style={`--k:${j + 1}`}>
                          <p class="exp-rt">{r.title}</p>
                          <p class="small">{r.meta}</p>
                          <ul class="bullets">
                            {r.bullets.map((b, k) => <li style={`--b:${k}`}>{b}</li>)}
                          </ul>
                        </div>
                      ))}
                      {e.url && (
                        <a class="ulink small" style={`--k:${e.roles.length + 1}`} href={e.url} target="_blank" rel="noopener noreferrer">Visit website ↗</a>
                      )}
                    </div>
                  </div>
                </div>
              </li>
            ))}
          </ol>
        </section>

        <!-- 04 Education -->
        <section id="education" class="sec edu" aria-labelledby="edu-h">
          <header class="sec-head reveal">
            <div>
              <p class="sec-n">03</p>
              <h2 id="edu-h">Education</h2>
            </div>
          </header>
          <div class="edu-stage">
            <div class="edu-copy">
              <p class="edu-level">Bachelor’s degree</p>
              <h3 class="edu-degree">
                <span class="edu-w"><span style="--w:0">Informatics</span></span>
                <span class="edu-w"><em style="--w:1">Engineering</em></span>
              </h3>
              <span class="edu-rule" aria-hidden="true"></span>
              <p class="edu-school">Universitas Hasanuddin</p>
              <p class="small edu-where">Makassar, Indonesia <span class="edu-yrs tnum">2022 – 2026</span></p>
            </div>
            <figure class="edu-plate" id="edu-plate" aria-hidden="true">
              <svg viewBox="0 0 480 480" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <defs>
                  <path id="edu-ring" d="M240 40 a200 200 0 1 1 -0.01 0" />
                </defs>
                <g class="edu-seal">
                  <circle class="ln" pathLength="1" cx="240" cy="240" r="222" style="--k:0" />
                  <circle class="ln" pathLength="1" cx="240" cy="240" r="176" style="--k:1" />
                  <text class="edu-txt" fill="currentColor" stroke="none"><textPath href="#edu-ring" textLength="1240" lengthAdjust="spacing">UNIVERSITAS HASANUDDIN · MAKASSAR · INFORMATICS ENGINEERING · 2022 – 2026 ·</textPath></text>
                </g>
                <g class="edu-arches">
                  <path class="ln l1" pathLength="1" d="M130 410 V270 A110 110 0 0 1 350 270 V410" style="--k:2" />
                  <path class="ln l2" pathLength="1" d="M165 410 V270 A75 75 0 0 1 315 270 V410" style="--k:3" />
                  <path class="ln l3" pathLength="1" d="M200 410 V270 A40 40 0 0 1 280 270 V410" style="--k:4" />
                  <path class="ln" pathLength="1" d="M96 410 H384" style="--k:5" />
                </g>
                <g class="edu-net">
                  <path class="ln" pathLength="1" d="M240 232 L212 292 M240 232 L268 292 M212 292 L268 292 M212 292 L240 352 M268 292 L240 352 M240 232 L240 352" style="--k:6" />
                  <circle class="nd" cx="240" cy="232" r="4.5" style="--n:0" />
                  <circle class="nd" cx="212" cy="292" r="4.5" style="--n:1" />
                  <circle class="nd" cx="268" cy="292" r="4.5" style="--n:2" />
                  <circle class="nd" cx="240" cy="352" r="4.5" style="--n:3" />
                </g>
              </svg>
            </figure>
          </div>
        </section>

        <!-- 05 Recognition -->
        <section id="recognition" class="sec" aria-labelledby="rec-h">
          <header class="sec-head reveal">
            <div>
              <p class="sec-n">04</p>
              <h2 id="rec-h">Recognition</h2>
            </div>
          </header>
          <ul class="rec" id="rec-list">
            {ACHIEVEMENTS.map((a, i) => (
              <li class="rec-row" style={`--i:${i}`}>
                <span class="rec-glow" aria-hidden="true"></span>
                <span class="rec-when tnum"><span>{a.date}</span></span>
                <div class="rec-body">
                  <h3>{a.title}</h3>
                  <p class="small">{a.description}</p>
                </div>
                <span class="rec-rank" aria-hidden="true">
                  <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
                    <circle class="rk-o ln" pathLength="1" cx="32" cy="32" r="30" />
                    <circle class="rk-d" cx="32" cy="32" r="24" />
                    <path class="ln" pathLength="1" d="M32 19 L35.2 28.6 L45 28.6 L37 34.6 L40 44 L32 38.2 L24 44 L27 34.6 L19 28.6 L28.8 28.6 Z" />
                  </svg>
                  <span class="rec-tag">{a.rank}</span>
                </span>
              </li>
            ))}
          </ul>
        </section>

        <!-- 06 Contact -->
        <section id="contact" class="sec contact" aria-labelledby="contact-h">
          <p class="sec-n">05</p>
          <h2 id="contact-h">Have something worth building?</h2>
          <a class="big-mail ulink" href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a>
          <div class="contact-actions">
            <button id="copy" class="btn" type="button">Copy email</button>
            <span id="copied" class="small" role="status" aria-live="polite"></span>
            {SOCIALS.map((s) => (
              <a class="ulink small" href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a>
            ))}
          </div>
        </section>

        <footer class="foot small">
          <span>© {year} {AUTHOR.name}</span>
          <span>Designed and built by hand</span>
        </footer>
      </main>
    </div>

    <script define:vars={{ email: AUTHOR.email }}>
      const root = document.documentElement;
      const $ = (s, r = document) => r.querySelector(s);
      const $$ = (s, r = document) => [...r.querySelectorAll(s)];

      // Theme
      const themeBtn = $('#theme');
      const syncTheme = () => {
        const dark = root.dataset.theme === 'dark';
        themeBtn.setAttribute('aria-pressed', String(dark));
        themeBtn.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
      };
      syncTheme();
      themeBtn.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.classList.add('theme-anim');
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
        syncTheme();
        setTimeout(() => root.classList.remove('theme-anim'), 350);
      });

      // Local time
      const clock = $('#clock');
      const tf = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Makassar' });
      const tick = () => { clock.textContent = tf.format(new Date()) + ' WITA'; };
      tick();
      setInterval(tick, 15000);

      // Table of contents follows the section in view
      const links = $$('.toc a');
      const map = new Map(links.map((a) => [a.dataset.target, a]));
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((en) => {
            if (en.isIntersecting) {
              links.forEach((a) => {
                if (a.dataset.target === en.target.id) a.setAttribute('aria-current', 'true');
                else a.removeAttribute('aria-current');
              });
            }
          });
        },
        { rootMargin: '-40% 0px -55% 0px' },
      );
      $$('main section[id]').forEach((s) => map.has(s.id) && io.observe(s));

      // Reveal on every entry: add .in when visible, remove it when it leaves so it replays
      const rm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const ro = new IntersectionObserver((es) => es.forEach((e) => {
        e.target.classList.toggle('in', e.isIntersecting);
      }), { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
      $$('.reveal, .sec').forEach((el) => ro.observe(el));

      // Project focus follows the reading line
      const grid = $('.grid');
      const cards = $$('.card', grid);
      const fo = new IntersectionObserver((es) => es.forEach((e) => {
        if (!e.isIntersecting) return;
        cards.forEach((c) => c.toggleAttribute('data-active', c === e.target));
        grid.dataset.focus = '';
      }), { rootMargin: '-45% 0px -45% 0px' });
      cards.forEach((c) => fo.observe(c));

      // Scroll progress
      const bar = $('#bar');
      const prog = () => {
        const h = root.scrollHeight - innerHeight;
        bar.style.transform = 'scaleX(' + (h > 0 ? Math.min(1, scrollY / h) : 0) + ')';
      };
      addEventListener('scroll', () => requestAnimationFrame(prog), { passive: true });
      prog();

      // Cursor label that follows the pointer over project cards
      const cur = $('#cursor');
      if (matchMedia('(hover: hover) and (pointer: fine)').matches && !rm) {
        let x = 0, y = 0, tx = 0, ty = 0, on = false, raf = 0;
        const loop = () => {
          x += (tx - x) * 0.18; y += (ty - y) * 0.18;
          cur.style.transform = 'translate3d(' + x + 'px,' + y + 'px,0) translate(-50%,-50%) scale(' + (on ? 1 : 0.6) + ')';
          raf = (Math.abs(tx - x) > 0.1 || Math.abs(ty - y) > 0.1) ? requestAnimationFrame(loop) : 0;
        };
        $$('[data-cursor]').forEach((el) => {
          el.addEventListener('pointerenter', (e) => { tx = x = e.clientX; ty = y = e.clientY; on = true; cur.classList.add('show'); if (!raf) raf = requestAnimationFrame(loop); });
          el.addEventListener('pointermove', (e) => { tx = e.clientX; ty = e.clientY; if (!raf) raf = requestAnimationFrame(loop); });
          el.addEventListener('pointerleave', () => { on = false; cur.classList.remove('show'); });
        });
      }

      // Experience
      $$('.exp-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const open = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!open));
          btn.closest('.exp-item').dataset.open = String(!open);
        });
      });

      // Experience spine: the line fills down to the reading line and each node lights as it is passed
      const expList = $('#exp-list');
      const expItems = $$('.exp-item', expList);
      const spine = () => {
        const top = expList.getBoundingClientRect().top;
        const line = innerHeight * 0.58 - top;
        const total = expList.offsetHeight;
        expList.style.setProperty('--p', Math.max(0, Math.min(1, line / total)).toFixed(4));
        expItems.forEach((it) => it.toggleAttribute('data-passed', line > it.offsetTop + 34));
      };
      addEventListener('scroll', () => requestAnimationFrame(spine), { passive: true });
      new ResizeObserver(spine).observe(expList);
      spine();

      // Education plate: layers drift against the pointer
      const plate = $('#edu-plate');
      if (plate && matchMedia('(hover: hover) and (pointer: fine)').matches && !rm) {
        plate.addEventListener('pointermove', (e) => {
          const r = plate.getBoundingClientRect();
          plate.style.setProperty('--mx', ((e.clientX - r.left) / r.width - 0.5).toFixed(3));
          plate.style.setProperty('--my', ((e.clientY - r.top) / r.height - 0.5).toFixed(3));
        });
        plate.addEventListener('pointerleave', () => { plate.style.setProperty('--mx', 0); plate.style.setProperty('--my', 0); });
      }

      // Recognition: reveal the list as one, and let a soft light follow the pointer across each row
      const rec = $('#rec-list');
      ro.observe(rec);
      if (matchMedia('(hover: hover) and (pointer: fine)').matches && !rm) {
        $$('.rec-row', rec).forEach((row) => row.addEventListener('pointermove', (e) => {
          const r = row.getBoundingClientRect();
          row.style.setProperty('--mx', (e.clientX - r.left) + 'px');
          row.style.setProperty('--my', (e.clientY - r.top) + 'px');
        }));
      }

      // Copy email
      const copied = $('#copied');
      $('#copy').addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(email);
          copied.textContent = 'Copied to clipboard';
        } catch (e) {
          copied.textContent = 'Press Ctrl+C to copy: ' + email;
        }
        setTimeout(() => (copied.textContent = ''), 2400);
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    --serif: 'Lora Variable', Georgia, serif;
    --sans: 'Inter Variable', system-ui, sans-serif;
    --mono: 'JetBrains Mono Variable', ui-monospace, monospace;
    --rail: 17rem;
    --gutter: clamp(1.5rem, 4.5vw, 5rem);
  }
  :root,
  [data-theme='light'] {
    --bg: #f4f1ea;
    --bg-2: #ece8df;
    --ink: #1d1b18;
    --muted: #6f6b63;
    --line: #d9d4c8;
    --accent: #8a4a30;
    --band-bg: #1d1b18; --band-ink: #f4f1ea; --band-muted: #a8a397; --band-line: #38342d; --band-2: #26231f; --band-accent: #e3ad8d;
    color-scheme: light;
  }
  [data-theme='dark'] {
    --bg: #141311;
    --bg-2: #1c1a17;
    --ink: #ece7dd;
    --muted: #9a958a;
    --line: #2d2a25;
    --accent: #dba685;
    --band-bg: #ece7dd; --band-ink: #1d1b18; --band-muted: #5f5b53; --band-line: #cdc7b8; --band-2: #e0dacb; --band-accent: #8a4a30;
    color-scheme: dark;
  }
  .theme-anim, .theme-anim *, .theme-anim *::before, .theme-anim *::after {
    transition: background-color 280ms ease, color 280ms ease, border-color 280ms ease !important;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; scroll-padding-top: 2rem; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 400 1rem/1.7 var(--sans); -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
  h1, h2, h3, p, ul, ol { margin: 0; padding: 0; }
  ul, ol { list-style: none; }
  a { color: inherit; text-decoration: none; }
  button { font: inherit; color: inherit; }
  img { display: block; max-width: 100%; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .tnum { font-variant-numeric: tabular-nums; }
  .small { font-size: 0.8125rem; color: var(--muted); line-height: 1.6; }
  em { font-style: italic; color: var(--accent); }
  h1, h2, h3 { font-family: var(--serif); font-weight: 400; letter-spacing: -0.02em; text-wrap: balance; }

  .skip { position: absolute; left: 1rem; top: -4rem; z-index: 20; background: var(--ink); color: var(--bg); padding: 0.6rem 1rem; font-size: 0.875rem; }
  .skip:focus { top: 1rem; }

  /* ---- Shell: fixed rail + reading column ---- */
  .shell { display: grid; grid-template-columns: var(--rail) minmax(0, 1fr); min-height: 100dvh; }
  .rail {
    position: sticky; top: 0; height: 100dvh; padding: 2.5rem 2rem 2rem 2.5rem;
    display: grid; grid-template-rows: 1fr auto 1fr;
    border-right: 1px solid var(--line);
  }
  /* Identity is centred horizontally and vertically in the space between the top and the nav */
  .rail-top { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
  /* Bottom row: abstract handwriting fills the gap above the clock and theme toggle */
  .rail-bottom { display: flex; flex-direction: column; justify-content: space-between; align-items: stretch; min-height: 0; }
  .scrawl { width: 100%; max-width: 12rem; height: auto; max-height: 100%; margin: auto; color: var(--accent); opacity: 0.7; overflow: visible; }
  .scrawl path { stroke-dasharray: 1; stroke-dashoffset: 0; }
  .js .scrawl path { stroke-dashoffset: 1; animation: scrawl 2.4s cubic-bezier(0.45, 0, 0.2, 1) forwards; }
  .js .scrawl path:nth-child(2) { animation-delay: 1.6s; animation-duration: 1s; }
  .js .scrawl path:nth-child(3) { animation-delay: 2.2s; animation-duration: 0.8s; }
  .js .scrawl path:nth-child(4) { animation-delay: 2.6s; animation-duration: 0.8s; }
  @keyframes scrawl { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .js .scrawl path { animation: none; stroke-dashoffset: 0; } }
  @media (max-height: 640px) { .scrawl { display: none; } }
  .avatar { margin: 0 0 1.5rem; width: 6.5rem; aspect-ratio: 3 / 4; border-radius: 999px 999px 0 0; overflow: hidden; background: var(--bg-2); outline: 1px solid var(--line); outline-offset: 5px; }
  .avatar img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; filter: grayscale(1) contrast(1.05) brightness(0.98); transition: filter 600ms var(--ease-out); }
  [data-theme='dark'] .avatar img { filter: grayscale(1) contrast(1.05) brightness(0.85); }
  .brand { font: 500 1.5rem/1 var(--serif); letter-spacing: -0.02em; font-style: italic; }
  .role-line { margin-top: 0.6rem; font-size: 0.8125rem; color: var(--muted); }

  .toc ol { display: grid; gap: 0.15rem; }
  .toc a { display: flex; align-items: baseline; gap: 0.9rem; padding: 0.4rem 0; color: var(--muted); transition: color 200ms ease, transform 240ms var(--ease-out); }
  .toc-n { font: 400 0.6875rem/1 var(--mono); letter-spacing: 0.04em; width: 1.4rem; }
  .toc-l { font-size: 0.9375rem; position: relative; }
  .toc-l::after { content: ''; position: absolute; left: 0; right: 0; bottom: -2px; height: 1px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform 320ms var(--ease-out); }
  .toc a[aria-current] { color: var(--ink); transform: translateX(4px); }
  .toc a[aria-current] .toc-n { color: var(--accent); }
  .toc a[aria-current] .toc-l::after { transform: scaleX(1); }

  .rail-foot { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .clock { display: flex; align-items: center; gap: 0.5rem; white-space: nowrap; font: 400 0.6875rem/1.4 var(--mono); letter-spacing: 0.02em; text-transform: uppercase; color: var(--muted); }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 45%, transparent); animation: ping 2.8s var(--ease-out) infinite; }
  @keyframes ping { 70%, 100% { box-shadow: 0 0 0 7px transparent; } }
  .theme { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 50%; border: 1px solid var(--line); background: none; cursor: pointer; transition: transform 160ms var(--ease-out), border-color 160ms ease; }
  .theme:active { transform: scale(0.94); }
  .theme svg { grid-area: 1 / 1; transition: opacity 200ms ease, transform 320ms var(--ease-out); }
  [data-theme='light'] .i-moon, [data-theme='dark'] .i-sun { opacity: 0; transform: rotate(-60deg) scale(0.6); }

  .main { padding: 0 var(--gutter); width: 100%; min-width: 0; overflow-x: clip; }

  .btn { display: inline-flex; align-items: center; height: 2.875rem; padding: 0 1.5rem; border-radius: 999px; background: var(--ink); color: var(--bg); border: 1px solid var(--ink); font-size: 0.875rem; font-weight: 500; cursor: pointer; transition: transform 160ms var(--ease-out), background-color 160ms ease, border-color 160ms ease; }
  .btn:active { transform: scale(0.97); }
  .ulink { background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat; background-size: 0 1px; transition: background-size 260ms var(--ease-out); padding-bottom: 2px; }
  .links .ulink { font-size: 0.9375rem; }

  /* ---- Section scaffold ---- */
  .sec { padding-block: clamp(5rem, 11vw, 9rem); border-top: 1px solid var(--line); }
  .sec-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .sec-n { font: 400 0.75rem/1 var(--mono); letter-spacing: 0.08em; color: var(--accent); margin-bottom: 1rem; }
  .sec h2 { font-size: clamp(2rem, 3.8vw, 3.25rem); line-height: 1.08; }

  /* ---- Projects: full-bleed inverted band + grid ---- */
  .band { padding-block: 0 clamp(5rem, 10vw, 9rem); position: relative; }
  .band-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; margin-bottom: clamp(3rem, 6vw, 5rem); }
  .band-head h2 { font-size: clamp(2rem, 4.4vw, 3.75rem); line-height: 1.08; max-width: 18ch; }

  .grid { display: grid; grid-template-columns: minmax(0, 1fr); }
  .card { position: relative; padding-block: clamp(2.5rem, 5vw, 4.5rem); }
  .card:first-child::before { display: none; }
  .card::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 1px; background: var(--line); transform-origin: left; }
  .card-link { display: flex; flex-direction: column; gap: clamp(1.25rem, 2vw, 1.75rem); transition: opacity 600ms var(--ease-out); }
  .card-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); border: 1px solid var(--line); }
  .card-left { display: flex; flex-direction: column; gap: 0.9rem; padding: clamp(1.25rem, 2.5vw, 2rem); border-right: 1px solid var(--line); }
  .card-left .card-title { display: block; }
  .card-left .card-no { display: block; margin-bottom: 0.9rem; }
  .card-no { font: 400 0.75rem/1 var(--mono); letter-spacing: 0.06em; color: var(--accent); }
  .card-title { justify-self: start; font: 400 clamp(1.75rem, 3.2vw, 2.75rem)/1.1 var(--serif); letter-spacing: -0.025em; text-wrap: balance; background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: background-size 420ms var(--ease-out); padding-bottom: 3px; }
  .card-status { font: 400 0.6875rem/1.4 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); white-space: nowrap; }
  /* Plate: a tinted stage, a line drawing from the project's subject, the real screens on top */
  .plate { --tint: color-mix(in oklab, var(--hue) 9%, var(--bg)); --stroke: color-mix(in oklab, var(--hue) 62%, var(--bg)); --deep: color-mix(in oklab, var(--hue) 55%, #0e0d0b);
    position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; container-type: inline-size; isolation: isolate;
    background: var(--tint); border: 1px solid color-mix(in oklab, var(--hue) 18%, var(--line)); }
  [data-theme='dark'] .plate { --tint: color-mix(in oklab, var(--hue) 16%, var(--bg)); --stroke: color-mix(in oklab, var(--hue) 70%, var(--ink)); }
  .art { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; fill: none; stroke: var(--stroke); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .art .bold { stroke-width: 2.6; }
  .art .gr { stroke-opacity: 0.35; stroke-dasharray: 2 8; }
  .art .fl { stroke: var(--stroke); stroke-opacity: 0.4; }
  .art pattern path { stroke: var(--stroke); stroke-width: 1.4; }
  .art .tx { fill: var(--stroke); stroke: none; font: 500 15px/1 var(--mono); letter-spacing: 0.12em; }
  .art .ds { stroke-dasharray: 0.006 0.012; }

  .screens { position: absolute; inset: 0; display: block; }
  .shot { position: absolute; display: block; overflow: hidden; background: #fff;
    box-shadow: 0 1.2cqw 3.2cqw -0.8cqw color-mix(in oklab, var(--deep) 45%, transparent), 0 0.2cqw 0.5cqw color-mix(in oklab, var(--deep) 18%, transparent);
    transition: translate 900ms var(--ease-out), rotate 900ms var(--ease-out); }
  .shot img { width: 100%; height: 100%; object-fit: cover; object-position: top center; }

  /* Phones: three handsets, the main one raised in the middle */
  .plate-phones .shot { top: 50%; height: 80%; aspect-ratio: 9 / 19.5; border: 0.45cqw solid #161512; border-radius: 2.6cqw; }
  .plate-phones .shot-1 { left: 50%; translate: -50% -52%; z-index: 2; }
  .plate-phones .shot-0 { left: 50%; translate: -158% -46%; rotate: -3deg; }
  .plate-phones .shot-2 { left: 50%; translate: 58% -46%; rotate: 3deg; }

  /* Browser: the main page and one detail page laid over its corner */
  .plate-browser .shot { border-radius: 0.7cqw; padding-top: 1.7cqw; aspect-ratio: 16 / 10.6; background: #fbfaf7; }
  .plate-browser .shot::before { content: ''; position: absolute; left: 1.1cqw; top: 0.6cqw; width: 18%; height: 0.5cqw; border-radius: 1cqw; background: color-mix(in oklab, var(--hue) 22%, #e9e6df); }
  .plate-browser .shot img { border-top: 1px solid #e6e2da; }
  .plate-browser .shot-0 { left: 9%; top: 9%; width: 66%; }
  .plate-browser .shot-1 { right: 6%; bottom: 7%; width: 38%; z-index: 2; }

  /* Stack dock: a small bordered grid that rises over the bottom of the plate, like the macOS dock */
  .dock { position: absolute; z-index: 5; left: 50%; bottom: 1.25cqw; display: flex; max-width: calc(100% - 4cqw); overflow: hidden;
    background: color-mix(in oklab, var(--bg) 78%, transparent); backdrop-filter: blur(14px) saturate(1.4); -webkit-backdrop-filter: blur(14px) saturate(1.4);
    border: 1px solid var(--line); border-radius: 0; box-shadow: 0 0.8rem 2rem -0.8rem color-mix(in oklab, var(--deep) 60%, transparent);
    opacity: 0; pointer-events: none; transform: translate(-50%, 140%) scale(0.92); transform-origin: 50% 100%;
    transition: transform 520ms cubic-bezier(0.34, 1.45, 0.64, 1), opacity 220ms ease; }
  .dock-i { padding: 0.5rem 0.8rem; font: 500 0.6875rem/1 var(--mono); letter-spacing: 0.02em; color: var(--ink); white-space: nowrap; border-left: 1px solid var(--line);
    opacity: 0; transform: translateY(0.6rem) scale(0.85); transition: opacity 200ms ease, transform 200ms ease; }
  .dock-i:first-child { border-left: 0; }
  .dock-more { color: var(--accent); }
  @media (hover: hover) and (pointer: fine) {
    .card-link:is(:hover, :focus-visible) .dock { opacity: 1; transform: translate(-50%, 0) scale(1); }
    .card-link:is(:hover, :focus-visible) .dock-i { opacity: 1; transform: none;
      transition: opacity 320ms ease calc(160ms + var(--k) * 45ms), transform 520ms cubic-bezier(0.34, 1.56, 0.64, 1) calc(160ms + var(--k) * 45ms); }
  }
  @media (max-width: 48rem) { .dock { display: none; } }

  .card-sum { color: var(--muted); font-size: 1rem; text-wrap: pretty; align-self: center; padding: clamp(1.25rem, 2.5vw, 2rem); }

  .cursor { position: fixed; left: 0; top: 0; z-index: 30; pointer-events: none; display: grid; place-items: center; width: 5.25rem; height: 5.25rem; border-radius: 50%; background: var(--accent); color: #1d1b18; font: 500 0.75rem/1 var(--sans); letter-spacing: 0.04em; opacity: 0; transition: opacity 200ms ease; will-change: transform; }
  .cursor.show { opacity: 1; }
  [data-theme='dark'] .cursor { color: #f4f1ea; background: #8a4a30; }

  .progress { position: fixed; left: 0; right: 0; top: 0; height: 2px; z-index: 25; pointer-events: none; }
  .progress i { display: block; height: 100%; background: var(--accent); transform: scaleX(0); transform-origin: left; }

  /* Reveal on enter, only when JS is on */
  .js .reveal { opacity: 0; transform: translateY(22px); transition: opacity 800ms var(--ease-out) calc(var(--i, 0) * 90ms), transform 900ms var(--ease-out) calc(var(--i, 0) * 90ms); }
  .js .reveal.in { opacity: 1; transform: none; }
  .js .card.reveal { opacity: 1; transform: none; transition: none; }
  .js .card::before { transform: scaleX(0); transition: transform 1100ms var(--ease-out); }
  .js .card.in::before { transform: none; }
  .js .card .card-left, .js .card .card-sum { opacity: 0; transform: translateY(14px); transition: opacity 700ms var(--ease-out), transform 800ms var(--ease-out); }
  .js .card .card-title { transition: opacity 700ms var(--ease-out), transform 800ms var(--ease-out), background-size 420ms var(--ease-out); }
    .js .card .plate { clip-path: inset(0 0 100% 0); transition: clip-path 900ms var(--ease-out) 100ms; }
  .js .card .art .ln { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1600ms cubic-bezier(0.45, 0, 0.2, 1) calc(400ms + min(var(--k), 14) * 45ms); }
  .js .card .art .ds { stroke-dasharray: 0.006 0.012; stroke-dashoffset: 0; opacity: 0; transition: opacity 900ms ease 900ms; }
  .js .card .art .tx, .js .card .art .fl { opacity: 0; transition: opacity 700ms ease 1300ms; }
  .js .card .shot { opacity: 0; transform: translateY(8cqw); transition: opacity 600ms var(--ease-out) calc(380ms + var(--j) * 110ms), transform 1100ms var(--ease-out) calc(380ms + var(--j) * 110ms), translate 900ms var(--ease-out), rotate 900ms var(--ease-out); }
  .js .card .card-sum { transition-delay: 380ms; }
  .js .card.in .card-left, .js .card.in .card-sum { opacity: 1; transform: none; }
  .js .card.in .plate { clip-path: inset(0); }
  .js .card.in .art .ln { stroke-dashoffset: 0; }
  .js .card.in .art .ds, .js .card.in .art .tx { opacity: 1; }
  .js .card.in .art .fl { opacity: 1; }
  .js .card.in .shot { opacity: 1; transform: none; }
  /* Scroll focus: the project at the reading line stays full strength */
  .grid[data-focus] .card:not([data-active]) .card-link { opacity: 0.5; }
  .sec { position: relative; border-top: 0; }
  .sec::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 1px; background: var(--line); transform-origin: left; }
  .js .sec::before { transform: scaleX(0); transition: transform 1200ms var(--ease-out); }
  .js .sec.in::before { transform: none; }
  .js .exp-item::before { transform: scaleX(0); transition: transform 1100ms var(--ease-out) calc(var(--i, 0) * 110ms); }
  .js .exp-item.in::before { transform: none; }

  /* ---- Experience ---- */
  .exp { position: relative; --p: 0; --col: 11rem; }
  /* Spine runs in the gap between the dates and the roles; it fills as the page is read */
  .exp::before, .exp::after { content: ''; position: absolute; left: calc(var(--col) + 0.75rem); top: 0; bottom: 0; width: 1px; }
  .exp::before { background: var(--line); }
  .exp::after { background: var(--accent); transform-origin: top; transform: scaleY(var(--p)); }
  .exp-item { position: relative; }
  .exp-item::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 1px; background: var(--line); transform-origin: left; }
  .exp-item:last-child { border-bottom: 1px solid var(--line); }
  .exp-item::after { content: ''; position: absolute; z-index: 1; left: calc(var(--col) + 0.75rem); top: 2.2rem; width: 9px; height: 9px; border-radius: 50%; translate: -50% 0;
    background: var(--bg); border: 1px solid var(--muted); transition: background-color 300ms ease, border-color 300ms ease, scale 500ms cubic-bezier(0.34, 1.56, 0.64, 1); }
  .exp-item[data-passed]::after { background: var(--accent); border-color: var(--accent); }
  .exp-item[data-open='true']::after { scale: 1.45; }
  .exp-item h3 { font: inherit; letter-spacing: 0; }
  .exp-btn { width: 100%; display: grid; grid-template-columns: var(--col) minmax(0, 1fr) 1.75rem; align-items: baseline; gap: 1.5rem; padding: 1.75rem 0; border: 0; text-align: left; cursor: pointer;
    background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 9%, transparent), transparent 70%) no-repeat 0 0 / 0 100%; transition: background-size 600ms var(--ease-out), opacity 300ms ease; }
  .exp-when { display: flex; flex-direction: column; gap: 0.2rem; font: 400 0.75rem/1.6 var(--mono); letter-spacing: 0.04em; color: var(--muted); }
  .exp-range { display: flex; align-items: center; gap: 0.5rem; white-space: nowrap; }
  .exp-range .dot { flex: none; }
  .exp-span { font-size: 0.6875rem; opacity: 0; translate: 0 -4px; transition: opacity 300ms ease, translate 400ms var(--ease-out); }
  [data-open='true'] .exp-span { opacity: 0.85; translate: 0; }
  .exp-main { display: flex; flex-direction: column; gap: 0.35rem; }
  .exp-co { font: 400 clamp(1.25rem, 2vw, 1.625rem)/1.2 var(--serif); letter-spacing: -0.015em; transition: transform 400ms var(--ease-out), color 200ms ease; }
  .exp-role { font-size: 0.875rem; color: var(--muted); }
  .exp-icon { position: relative; width: 1.75rem; height: 1.75rem; border-radius: 50%; border: 1px solid var(--line); justify-self: end; align-self: center;
    transition: transform 500ms var(--ease-out), background-color 250ms ease, border-color 250ms ease; }
  .exp-icon::before, .exp-icon::after { content: ''; position: absolute; background: var(--ink); transition: transform 400ms var(--ease-out), background-color 250ms ease; }
  .exp-icon::before { left: 7px; right: 7px; top: 50%; height: 1px; }
  .exp-icon::after { top: 7px; bottom: 7px; left: 50%; width: 1px; }
  [data-open='true'] .exp-icon { transform: rotate(180deg); background: var(--accent); border-color: var(--accent); }
  [data-open='true'] .exp-icon::before { background: var(--bg); }
  [data-open='true'] .exp-icon::after { transform: scaleY(0); }
  [data-open='true'] .exp-co { color: var(--accent); }

  .exp-panel { display: grid; grid-template-rows: 0fr; visibility: hidden; transition: grid-template-rows 420ms var(--ease-out), visibility 0s linear 420ms; }
  [data-open='true'] .exp-panel { grid-template-rows: 1fr; visibility: visible; transition: grid-template-rows 520ms var(--ease-out), visibility 0s; }
  .exp-clip { overflow: hidden; min-height: 0; }
  .exp-body { padding: 0 1.5rem 2.5rem calc(var(--col) + 1.5rem); display: grid; gap: 1.75rem; justify-items: start; }
  /* Contents settle in one after another when a row opens, and leave quickly when it closes */
  .exp-body > * { opacity: 0; translate: 0 12px; filter: blur(4px); transition: opacity 150ms ease, translate 150ms ease, filter 150ms ease; }
  [data-open='true'] .exp-body > * { opacity: 1; translate: 0; filter: none;
    transition: opacity 600ms var(--ease-out) calc(140ms + var(--k, 0) * 90ms), translate 700ms var(--ease-out) calc(140ms + var(--k, 0) * 90ms), filter 600ms var(--ease-out) calc(140ms + var(--k, 0) * 90ms); }
  .exp-roleblock { display: grid; gap: 0.25rem; }
  .exp-rt { font: 400 1.0625rem/1.4 var(--serif); }
  .bullets { margin-top: 0.85rem; display: grid; gap: 0.7rem; }
  .bullets li { position: relative; padding-left: 1.25rem; color: var(--muted); font-size: 0.9375rem; text-wrap: pretty; max-width: 60ch; }
  .bullets li::before { content: ''; position: absolute; left: 0; top: 0.85em; width: 0.55rem; height: 1px; background: var(--accent); transform-origin: left; transform: scaleX(0); transition: transform 200ms ease; }
  [data-open='true'] .bullets li::before { transform: none; transition: transform 500ms var(--ease-out) calc(380ms + var(--k, 0) * 90ms + var(--b, 0) * 70ms); }

  /* ---- Education ---- */
  .edu-stage { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: clamp(2rem, 6vw, 6rem); align-items: end; }
  .edu-copy { display: flex; flex-direction: column; align-items: flex-start; padding-bottom: 0.5rem; }
  .edu-level { font: 400 0.75rem/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin-bottom: 1.75rem; }
  .edu-level span { color: var(--accent); margin-inline: 0.35em; }
  .edu-degree { display: flex; flex-direction: column; font-size: clamp(2.75rem, 7vw, 6rem); line-height: 1; letter-spacing: -0.035em; }
