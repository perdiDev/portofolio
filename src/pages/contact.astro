---
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import SocialLinks from '../components/SocialLinks.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHOR } from '../config';
import { breadcrumbJsonLd } from '../utils/jsonld';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Contact', href: '/contact/' },
];
---

<BaseLayout
  title="Contact"
  description={`Get in touch with ${AUTHOR.name}: the best way is email. You can also find me on GitHub and LinkedIn.`}
  jsonLd={[breadcrumbJsonLd(Astro.site!, crumbs)]}
>
  <div class="page page-top">
    <PageHeader
      title="Contact"
      intro="Questions about an article, a correction, or something you'd like me to write about? Email is the best way to reach me."
      breadcrumbs={crumbs}
    />

    <section aria-labelledby="email-heading">
      <h2 id="email-heading" class="eyebrow mb-3">
        Email
      </h2>
      <a
        href={`mailto:${AUTHOR.email}`}
        class="inline-flex items-center gap-3 font-serif text-2xl text-heading underline decoration-accent/50 underline-offset-4 hover:decoration-accent sm:text-3xl"
      >
        <Icon name="mail" class="size-6 text-accent" />
        {AUTHOR.email}
      </a>
      <p class="mt-3 text-muted">
        I read everything and reply when I can, usually within a few days.
      </p>
    </section>

    <section class="mt-14" aria-labelledby="social-heading">
      <h2 id="social-heading" class="eyebrow mb-3">
        Elsewhere
      </h2>
      <SocialLinks variant="list" />
    </section>
  </div>
</BaseLayout>
