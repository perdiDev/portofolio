---
import FoundationLayout, { type NavItem } from '../layouts/FoundationLayout.astro';
import Work from '../components/Work.astro';
import Experience from '../components/Experience.astro';
import Education from '../components/Education.astro';
import Recognition from '../components/Recognition.astro';
import Contact from '../components/Contact.astro';
import { AUTHOR, SITE } from '../config';
import { personJsonLd, websiteJsonLd } from '../utils/jsonld';

const site = Astro.site!;

const nav = [
  { id: 'work', label: 'Craft' },
  { id: 'experience', label: 'Journey' },
  { id: 'education', label: 'Foundations' },
  { id: 'recognition', label: 'Recognition' },
  { id: 'contact', label: 'Connect' },
] as const satisfies readonly NavItem[];

const n = (id: (typeof nav)[number]['id']) =>
  String(nav.findIndex((item) => item.id === id) + 1).padStart(2, '0');
const label = (id: (typeof nav)[number]['id']) => nav.find((item) => item.id === id)!.label;
---

<FoundationLayout
  title="Home"
  description={SITE.description}
  heading={`${AUTHOR.name}, ${AUTHOR.jobTitle}`}
  nav={nav}
  seo={{ fullTitle: SITE.homeTitle, jsonLd: [websiteJsonLd(site), personJsonLd(site)] }}
>
  <Work id="work" title={label('work')} />
  <Experience id="experience" n={n('experience')} title={label('experience')} />
  <Education id="education" n={n('education')} title={label('education')} />
  <Recognition id="recognition" n={n('recognition')} title={label('recognition')} />
  <Contact id="contact" n={n('contact')} title={label('contact')} />
</FoundationLayout>
