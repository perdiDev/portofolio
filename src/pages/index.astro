---
import Experience from '../components/Experience.astro';
import Icon from '../components/Icon.astro';
import Newsletter from '../components/Newsletter.astro';
import PostList from '../components/PostList.astro';
import ProjectRow from '../components/ProjectRow.astro';
import SocialLinks from '../components/SocialLinks.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHOR, BLOG, SITE } from '../config';
import { personJsonLd, websiteJsonLd } from '../utils/jsonld';
import { getPosts, getProjects } from '../utils/posts';

const [posts, projects] = await Promise.all([getPosts(), getProjects()]);
const site = Astro.site!;
---

<BaseLayout
  title="Home"
  fullTitle={SITE.homeTitle}
  description={SITE.description}
  jsonLd={[websiteJsonLd(site), personJsonLd(site)]}
>
  <div class="page page-top">
    <section aria-labelledby="intro-heading">
      <h1 id="intro-heading" class="text-4xl leading-[1.1] sm:text-6xl">
        Software engineer, writing things down.
      </h1>
      <p class="mt-6 max-w-[56ch] font-serif text-xl leading-relaxed text-muted">{AUTHOR.intro}</p>
      <SocialLinks class="mt-7" />
    </section>

    <section class="mt-24" aria-labelledby="experience-heading">
      <h2 id="experience-heading" class="mb-8 text-3xl">
        Experience
      </h2>
      <Experience />
    </section>

    <section class="mt-24" aria-labelledby="latest-heading">
      <div class="mb-8 flex items-baseline justify-between gap-4">
        <h2 id="latest-heading" class="text-3xl">
          Latest writing
        </h2>
        <a
          href="/blog/"
          class="link-grow inline-flex items-center gap-1.5 text-sm text-muted hover:text-text"
        >
          All posts <Icon name="arrow-right" class="size-4" />
        </a>
      </div>
      <PostList posts={posts.slice(0, BLOG.homePostCount)} as="h3" />
    </section>

    <section class="reveal mt-24" aria-labelledby="projects-heading">
      <div class="mb-4 flex items-baseline justify-between gap-4">
        <h2 id="projects-heading" class="text-3xl">
          Projects
        </h2>
        <a
          href="/projects/"
          class="link-grow inline-flex items-center gap-1.5 text-sm text-muted hover:text-text"
        >
          All projects <Icon name="arrow-right" class="size-4" />
        </a>
      </div>
      <ul class="divide-y divide-border border-y border-border">
        {projects.slice(0, 3).map((project, index) => (
          <li>
            <ProjectRow project={project} as="h3" index={index} />
          </li>
        ))}
      </ul>
    </section>

    <Newsletter id="home-newsletter" class="reveal mt-24" />
  </div>
</BaseLayout>
