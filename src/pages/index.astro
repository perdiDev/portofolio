---
import { getImage } from 'astro:assets';
import FoundationLayout, { type NavItem } from '../layouts/FoundationLayout.astro';
import Work from '../components/sections/Work.astro';
import Experience from '../components/sections/Experience.astro';
import Education from '../components/sections/Education.astro';
import Recognition from '../components/sections/Recognition.astro';
import Contact from '../components/sections/Contact.astro';
import photo from '../assets/photo.jpeg';
import { AUTHOR, SITE } from '../config';
import { profilePageJsonLd, websiteJsonLd } from '../utils/jsonld';

const site = Astro.site!;
// Same transform as the rail portrait, so the URL is shared and the file is built once.
const portrait = await getImage({ src: photo, width: 400, format: 'webp' });

const nav = [
  { id: 'work', label: 'Craft' },
  { id: 'experience', label: 'Journey' },
  { id: 'education', label: 'Foundations' },
  { id: 'recognition', label: 'Recognition' },
  { id: 'contact', label: 'Connect' },
] as const satisfies readonly NavItem[];

const n = (id: (typeof nav)[number]['id']) =>
  String(nav.findIndex((item) => item.id === id) + 1).padStart(2, '0');
const label = (id: (typeof nav)[number]['id']) => nav.find((item) => item.id === id)!.label;
---

<FoundationLayout
  title="Home"
  description={SITE.homeDescription}
  heading={`${AUTHOR.name}, ${AUTHOR.jobTitle} in ${AUTHOR.location.city}`}
  nav={nav}
  seo={{
    fullTitle: SITE.homeTitle,
    jsonLd: [websiteJsonLd(site), profilePageJsonLd(site, portrait.src)],
  }}
>
  <Work id="work" title={label('work')} />
  <Experience id="experience" n={n('experience')} title={label('experience')} />
  <Education id="education" n={n('education')} title={label('education')} />
  <Recognition id="recognition" n={n('recognition')} title={label('recognition')} />
  <Contact id="contact" n={n('contact')} title={label('contact')} />
</FoundationLayout>
