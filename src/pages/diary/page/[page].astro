---
import type { GetStaticPaths } from 'astro';
import ListingLayout from '../../../layouts/ListingLayout.astro';
import { extraPageNumbers, paginate } from '../../../utils/paginate';
import { getPosts } from '../../../utils/posts';
import { getCategories } from '../../../utils/taxonomy';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return extraPageNumbers(posts.length).map((n) => ({ params: { page: String(n) } }));
}) satisfies GetStaticPaths;

const posts = await getPosts();
const page = paginate(posts, Number(Astro.params.page), '/diary/');
const categories = getCategories(posts);
---

<ListingLayout
  heading="Diary"
  label="Diary"
  intro="Notes on programming, Linux and software engineering, written as I learn them."
  description="Diary of Perdi: articles on programming, Linux, and software engineering by Perdi: practical, example-driven writing for developers."
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Diary', href: '/diary/' },
  ]}
  base="/diary/"
  page={page}
  categories={categories}
/>
