---
import ListingLayout from '../../layouts/ListingLayout.astro';
import { paginate } from '../../utils/paginate';
import { getPosts } from '../../utils/posts';
import { getCategories } from '../../utils/taxonomy';

const posts = await getPosts();
const page = paginate(posts, 1, '/diary/');
const categories = getCategories(posts);
---

<ListingLayout
  heading="Diary"
  label="Diary"
  intro="Notes on programming, Linux and software engineering, written as I learn them."
  description="Technical diary by Perdi @perdidev: practical, example-driven articles on programming, Linux and software engineering."
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Diary', href: '/diary/' },
  ]}
  base="/diary/"
  page={page}
  categories={categories}
/>
