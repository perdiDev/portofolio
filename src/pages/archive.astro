---
import ListingLayout from '../layouts/ListingLayout.astro';
import { pluralize } from '../utils/format';
import { paginate } from '../utils/paginate';
import { getPosts } from '../utils/posts';

const posts = await getPosts();
const page = paginate(posts, 1, '/archive/', Math.max(posts.length, 1));
---

<ListingLayout
  heading="Archive"
  label="Archive"
  intro={`${pluralize(posts.length, 'entry', 'entries')}, newest first.`}
  description={`Every article on the blog in one list, newest first. ${pluralize(posts.length, 'post')} so far.`}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Archive', href: '/archive/' },
  ]}
  base="/archive/"
  page={page}
  kicker={{ label: 'Diary', href: '/blog/' }}
/>
