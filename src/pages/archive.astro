---
import FoundationLayout from '../layouts/FoundationLayout.astro';
import Archive from '../components/Archive.astro';
import { pluralize } from '../utils/format';
import { breadcrumbJsonLd } from '../utils/jsonld';
import { getPosts } from '../utils/posts';

const posts = await getPosts();
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Archive', href: '/archive/' },
];
---

<FoundationLayout
  title="Archive"
  description={`Every article on the blog in one list, grouped by year. ${pluralize(posts.length, 'post')} so far.`}
  heading="Archive"
  ownHeading
  seo={{ jsonLd: [breadcrumbJsonLd(Astro.site!, crumbs)] }}
>
  <Archive posts={posts} />
</FoundationLayout>
