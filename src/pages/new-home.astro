---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/lora';
import '@fontsource-variable/lora/wght-italic.css';
import { ACHIEVEMENTS, AUTHOR, EXPERIENCE, SKILLS, SOCIALS } from '../config';
import { getProjects, projectUrl } from '../utils/posts';

const projects = (await getProjects()).slice(0, 4);

const fmt = (ym: string) => {
  const [y, m] = ym.split('-').map(Number);
  return new Date(Date.UTC(y, m - 1, 1)).toLocaleDateString('en-US', {
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  });
};

const experience = EXPERIENCE.map((entry) => {
  const starts = entry.roles.map((r) => r.startDate).sort();
  const ongoing = entry.roles.some((r) => r.endDate === null);
  const ends = entry.roles.map((r) => r.endDate ?? '').sort();
  const start = starts[0];
  const end = ongoing ? 'Present' : fmt(ends[ends.length - 1].replace(/-(\d)$/, '-0$1'));
  const first = entry.roles[0];
  const summary = first.description.split('•').map((s) => s.trim()).filter(Boolean)[0] ?? '';
  return {
    company: entry.company,
    url: entry.companyUrl,
    location: entry.location,
    title: entry.roles.map((r) => r.title).join(' / '),
    range: `${fmt(start)} – ${end}`,
    summary,
  };
}).slice(0, 5);

const description = `${AUTHOR.name}, ${AUTHOR.jobTitle}. ${AUTHOR.bio}`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Perdi — Software Engineer</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <div class="frame">
      <!-- Masthead -->
      <header class="row masthead">
        <div class="cell cell-name"><span class="mark">Perdi</span></div>
        <div class="cell cell-status">
          <span class="dot" aria-hidden="true"></span>
          <span class="label">Available for new work</span>
        </div>
        <div class="cell cell-mail">
          <a class="ulink" href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a>
        </div>
      </header>

      <main id="main">
        <!-- Hero -->
        <section class="row hero" aria-labelledby="h1">
          <div class="cell hero-copy">
            <p class="label rise" style="--d:0ms">{AUTHOR.jobTitle} · Indonesia</p>
            <h1 id="h1" class="rise" style="--d:70ms">
              Software built to be <em>quiet</em>, fast and easy to trust.
            </h1>
            <p class="lede rise" style="--d:150ms">
              {AUTHOR.bio} I work across web, mobile and backend, from the database to the last pixel.
            </p>
            <div class="actions rise" style="--d:220ms">
              <a class="btn btn-solid" href="#work">See selected work</a>
              <a class="btn" href={`mailto:${AUTHOR.email}`}>Send an email</a>
            </div>
          </div>
          <aside class="cell hero-facts" aria-label="At a glance">
            <dl>
              <div class="fact rise" style="--d:260ms">
                <dt class="label">Experience</dt>
                <dd>4+ years</dd>
              </div>
              <div class="fact rise" style="--d:300ms">
                <dt class="label">Focus</dt>
                <dd>Fullstack, Mobile</dd>
              </div>
              <div class="fact rise" style="--d:340ms">
                <dt class="label">Based in</dt>
                <dd>Makassar, ID</dd>
              </div>
              <div class="fact rise" style="--d:380ms">
                <dt class="label">Elsewhere</dt>
                <dd class="links">
                  {SOCIALS.map((s) => (
                    <a class="ulink" href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a>
                  ))}
                </dd>
              </div>
            </dl>
          </aside>
        </section>

        <!-- Selected work -->
        <section id="work" class="section" aria-labelledby="work-h">
          <div class="row">
            <div class="cell sec-head">
              <span class="label">01</span>
              <h2 id="work-h">Selected work</h2>
            </div>
          </div>
          <ul class="row projects">
            {projects.map((p, i) => (
              <li class="cell project">
                <a href={projectUrl(p)} class="project-link">
                  <span class="label">{String(i + 1).padStart(2, '0')} · {p.data.status}</span>
                  <h3>{p.data.title}</h3>
                  <p>{p.data.summary}</p>
                  <span class="stack">{p.data.techStack.slice(0, 4).join(' · ')}</span>
                  <span class="arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </section>

        <!-- Experience -->
        <section class="section" aria-labelledby="exp-h">
          <div class="row">
            <div class="cell sec-head">
              <span class="label">02</span>
              <h2 id="exp-h">Experience</h2>
            </div>
          </div>
          <ol class="table">
            {experience.map((e) => (
              <li class="row tr">
                <div class="cell td-when label">{e.range}</div>
                <div class="cell td-who">
                  <h3>
                    {e.url ? (
                      <a class="ulink" href={e.url} target="_blank" rel="noopener noreferrer">{e.company}</a>
                    ) : (
                      e.company
                    )}
                  </h3>
                  <p class="label">{e.location}</p>
                </div>
                <div class="cell td-what">
                  <p class="role">{e.title}</p>
                  <p class="muted">{e.summary}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>

        <!-- Skills -->
        <section class="section" aria-labelledby="skills-h">
          <div class="row">
            <div class="cell sec-head">
              <span class="label">03</span>
              <h2 id="skills-h">Capabilities</h2>
            </div>
          </div>
          <ul class="row skills">
            {SKILLS.map((g) => (
              <li class="cell skill">
                <h3>{g.title}</h3>
                <p class="muted">{g.description}</p>
                <p class="tags">{g.skills.join(', ')}</p>
              </li>
            ))}
          </ul>
        </section>

        <!-- Recognition -->
        <section class="section" aria-labelledby="ach-h">
          <div class="row">
            <div class="cell sec-head">
              <span class="label">04</span>
              <h2 id="ach-h">Recognition</h2>
            </div>
          </div>
          <ul class="table">
            {ACHIEVEMENTS.slice(0, 4).map((a) => (
              <li class="row tr">
                <div class="cell td-when label">{a.date}</div>
                <div class="cell td-who wide">
                  <h3>{a.title}</h3>
                  <p class="label">{a.description}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>

        <!-- Contact -->
        <section class="section" aria-labelledby="contact-h">
          <div class="row contact">
            <div class="cell contact-copy">
              <span class="label">05 · Contact</span>
              <h2 id="contact-h">Have something worth building?</h2>
              <a class="btn btn-solid" href={`mailto:${AUTHOR.email}`}>Start a conversation</a>
            </div>
          </div>
        </section>
      </main>

      <footer class="row foot">
        <div class="cell label">© {year} {AUTHOR.name}</div>
        <div class="cell label foot-r">Designed and built by hand</div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfaf8;
    --paper: #fbfaf8;
    --ink: #17171a;
    --muted: #6a6a70;
    --line: #dcdad4;
    --line-strong: #bdbab2;
    --hover: #f3f1ec;
    --accent: #0b6b52;
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    --serif: 'Lora Variable', Georgia, serif;
    --sans: 'Inter Variable', system-ui, sans-serif;
    --mono: 'JetBrains Mono Variable', ui-monospace, monospace;
    --pad: clamp(1.25rem, 3vw, 2.25rem);
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0d0d0f;
      --paper: #0d0d0f;
      --ink: #ececea;
      --muted: #94949a;
      --line: #26262a;
      --line-strong: #3a3a40;
      --hover: #141417;
      --accent: #6ee7b7;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 400 1rem/1.6 var(--sans);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  h1, h2, h3, p, ul, ol, dl, dd { margin: 0; padding: 0; }
  ul, ol { list-style: none; }
  a { color: inherit; text-decoration: none; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .skip {
    position: absolute; left: 1rem; top: -4rem; z-index: 10;
    background: var(--ink); color: var(--bg); padding: 0.6rem 1rem; font-size: 0.875rem;
  }
  .skip:focus { top: 1rem; }

  /* ---- Grid frame: hairline borders, shared edges ---- */
  .frame {
    max-width: 80rem;
    margin: 0 auto;
    min-height: 100dvh;
    border-inline: 1px solid var(--line);
    position: relative;
  }
  .row { display: grid; border-bottom: 1px solid var(--line); }
  .cell { padding: var(--pad); min-width: 0; position: relative; }
  .row > .cell + .cell { border-left: 1px solid var(--line); }

  /* crosshair marks where rules meet the frame */
  .section > .row:first-child .cell::before,
  .hero::before {
    content: '+';
    position: absolute; top: -0.62em; left: -0.34em;
    font: 300 1rem/1 var(--mono); color: var(--line-strong);
    pointer-events: none;
  }
  .hero { position: relative; }
  .hero::before { top: auto; bottom: -0.62em; left: -0.34em; }

  .label {
    font: 500 0.6875rem/1.4 var(--mono);
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted);
  }
  .muted { color: var(--muted); }
  h1, h2, h3 { font-family: var(--serif); font-weight: 450; letter-spacing: -0.015em; text-wrap: balance; }
  em { font-style: italic; color: var(--accent); }

  /* ---- Masthead ---- */
  .masthead { grid-template-columns: 1fr auto auto; align-items: center; }
  .masthead .cell { padding-block: 1rem; }
  .mark { font: 500 1.125rem/1 var(--serif); letter-spacing: -0.01em; }
  .cell-status { display: flex; align-items: center; gap: 0.6rem; }
  .cell-mail { font-size: 0.875rem; }
  .dot {
    width: 6px; height: 6px; border-radius: 50%; background: var(--accent);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 50%, transparent);
    animation: ping 2.8s var(--ease-out) infinite;
  }
  @keyframes ping { 70%, 100% { box-shadow: 0 0 0 7px transparent; } }

  /* ---- Hero ---- */
  .hero { grid-template-columns: minmax(0, 1.9fr) minmax(0, 1fr); }
  .hero-copy {
    padding-block: clamp(3.5rem, 11vw, 8.5rem) clamp(2.5rem, 6vw, 4.5rem);
    display: flex; flex-direction: column; align-items: flex-start; gap: 1.5rem;
  }
  h1 { font-size: clamp(2.5rem, 6.4vw, 5.25rem); line-height: 1.04; max-width: 15ch; }
  .lede { max-width: 52ch; color: var(--muted); font-size: 1.0625rem; text-wrap: pretty; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.5rem; }

  .hero-facts { padding: 0; }
  .hero-facts dl { display: grid; height: 100%; grid-auto-rows: 1fr; }
  .fact { padding: var(--pad); display: flex; flex-direction: column; justify-content: center; gap: 0.35rem; }
  .fact + .fact { border-top: 1px solid var(--line); }
  .fact dd { font: 450 1.25rem/1.3 var(--serif); }
  .fact .links { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; font: 400 0.9375rem/1.4 var(--sans); }

  /* ---- Buttons & links ---- */
  .btn {
    display: inline-flex; align-items: center; height: 2.75rem; padding: 0 1.25rem;
    border: 1px solid var(--line-strong); font-size: 0.875rem; font-weight: 500;
    transition: transform 160ms var(--ease-out), background-color 160ms ease, color 160ms ease, border-color 160ms ease;
  }
  .btn-solid { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .btn:active { transform: scale(0.97); }
  .ulink {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 220ms var(--ease-out);
    padding-bottom: 1px;
  }

  /* ---- Sections ---- */
  .section { position: relative; }
  .sec-head { display: flex; align-items: baseline; gap: 1.25rem; padding-block: 1.1rem; }
  .sec-head h2 { font: 450 1.0625rem/1.2 var(--sans); letter-spacing: 0; }

  /* Projects: 2x2 */
  .projects { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .project { padding: 0; }
  .projects > .project:nth-child(n + 3) { border-top: 1px solid var(--line); }
  .projects > .project:nth-child(even) { border-left: 1px solid var(--line); }
  .project-link {
    display: flex; flex-direction: column; gap: 0.75rem; height: 100%;
    padding: var(--pad); padding-bottom: calc(var(--pad) + 0.5rem); min-height: 16rem;
    transition: background-color 200ms ease;
  }
  .project h3 { font-size: clamp(1.4rem, 2.4vw, 1.875rem); line-height: 1.15; max-width: 22ch; }
  .project p { color: var(--muted); max-width: 46ch; text-wrap: pretty; }
  .stack { margin-top: auto; padding-top: 1rem; font: 400 0.75rem/1.5 var(--mono); color: var(--muted); }
  .arrow {
    position: absolute; top: var(--pad); right: var(--pad); font: 300 1.25rem/1 var(--mono);
    color: var(--muted); transition: transform 220ms var(--ease-out), color 160ms ease;
  }
  .project-link:active { transform: scale(0.99); }

  /* Tables (experience, recognition) */
  .tr { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr) minmax(0, 2.2fr); transition: background-color 200ms ease; }
  .tr:has(.wide) { grid-template-columns: minmax(0, 1fr) minmax(0, 3.6fr); }
  .td-when { padding-top: calc(var(--pad) + 0.3rem); font-variant-numeric: tabular-nums; }
  .td-who h3 { font-size: 1.25rem; line-height: 1.25; }
  .td-who .label { margin-top: 0.4rem; }
  .role { font-weight: 500; font-size: 0.9375rem; }
  .td-what .muted {
    margin-top: 0.4rem; font-size: 0.9375rem; text-wrap: pretty;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }

  /* Skills: 4 columns */
  .skills { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .skill { display: flex; flex-direction: column; gap: 0.75rem; min-height: 15rem; }
  .skill h3 { font-size: 1.375rem; }
  .skill .muted { font-size: 0.9375rem; text-wrap: pretty; }
  .tags { margin-top: auto; font: 400 0.75rem/1.7 var(--mono); }

  /* Contact */
  .contact { grid-template-columns: 1fr; }
  .contact-copy {
    display: flex; flex-direction: column; align-items: flex-start; gap: 1.5rem;
    padding-block: clamp(3.5rem, 9vw, 7rem);
  }
  .contact h2 { font-size: clamp(2rem, 4.8vw, 3.75rem); line-height: 1.08; max-width: 18ch; }

  /* Footer */
  .foot { grid-template-columns: 1fr 1fr; border-bottom: 0; }
  .foot .cell { padding-block: 1.1rem; }
  .foot-r { text-align: right; }

  /* ---- Hover (pointer devices only) ---- */
  @media (hover: hover) and (pointer: fine) {
    .btn-solid:hover { background: var(--accent); border-color: var(--accent); color: var(--bg); }
    .btn:not(.btn-solid):hover { background: var(--hover); border-color: var(--ink); }
    .ulink:hover { background-size: 100% 1px; }
    .project-link:hover { background: var(--hover); }
    .project-link:hover .arrow { transform: translate(3px, -3px); color: var(--ink); }
    .tr:hover { background: var(--hover); }
  }

  /* ---- Entrance: once, on load ---- */
  .rise { opacity: 0; transform: translateY(10px); animation: rise 600ms var(--ease-out) var(--d, 0ms) forwards; }
  @keyframes rise { to { opacity: 1; transform: none; } }

  /* ---- Responsive ---- */
  @media (max-width: 64rem) {
    .skills { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .skills > .skill:nth-child(n + 3) { border-top: 1px solid var(--line); }
    .skills > .skill:nth-child(3) { border-left: 0; }
  }
  @media (max-width: 48rem) {
    .masthead { grid-template-columns: 1fr auto; }
    .cell-status { display: none; }
    .hero, .projects, .skills, .tr, .tr:has(.wide) { grid-template-columns: 1fr; }
    .row > .cell + .cell,
    .projects > .project:nth-child(even) { border-left: 0; }
    .hero-facts { border-top: 1px solid var(--line); }
    .hero-facts dl { grid-template-columns: 1fr 1fr; }
    .fact:nth-child(even) { border-left: 1px solid var(--line); }
    .fact:nth-child(n + 3) { border-top: 1px solid var(--line); }
    .fact:nth-child(2) { border-top: 0; }
    .projects > .project + .project,
    .skills > .skill + .skill { border-top: 1px solid var(--line); }
    .tr .td-who, .tr .td-what { border-top: 0; }
    .td-when { padding-bottom: 0; padding-top: var(--pad); }
    .tr .td-who { padding-bottom: 0.25rem; }
    .skill { min-height: 0; }
    .project-link { min-height: 0; }
    .btn { height: 3rem; }
    .actions .btn { flex: 1 1 auto; justify-content: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .dot { animation: none; }
    .rise { animation: fade 300ms ease var(--d, 0ms) forwards; transform: none; }
    @keyframes fade { to { opacity: 1; } }
    .btn, .ulink, .arrow { transition: none; }
  }
</style>
