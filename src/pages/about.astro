---
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import SocialLinks from '../components/SocialLinks.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import avatar from '../assets/photo.jpeg';
import { ABOUT, AUTHOR, SITE } from '../config';
import { breadcrumbJsonLd, profilePageJsonLd } from '../utils/jsonld';

const site = Astro.site!;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/about/' },
];
---

<BaseLayout
  title="About"
  description={`About ${AUTHOR.name}, a software engineer who writes about programming, Linux, and software engineering for developers.`}
  jsonLd={[profilePageJsonLd(site, '/about/'), breadcrumbJsonLd(site, crumbs)]}
>
  <div class="page page-top">
    <PageHeader title={`About ${AUTHOR.name}`} breadcrumbs={crumbs} />

    <div class="flex flex-col gap-8 sm:flex-row sm:items-start">
      <Image
        src={avatar}
        alt={`Portrait placeholder for ${AUTHOR.name}: the letter P in a circle`}
        width={160}
        height={160}
        densities={[1, 2]}
        priority
        class="size-32 shrink-0 rounded-full border border-border sm:size-40"
      />
      <div>
        <p class="font-serif text-xl leading-relaxed">{AUTHOR.bio}</p>
        <p class="mt-4 text-muted">
          I write because explaining something is the fastest
          way to find out whether I really understand it, and because the articles I wished existed
          are usually the ones worth writing.
        </p>
        {SITE.cvUrl && (
          <p class="mt-6">
            <a href={SITE.cvUrl} class="btn" download>
              <Icon name="download" class="size-4" /> Download CV
            </a>
          </p>
        )}
      </div>
    </div>

    <section class="mt-16" aria-labelledby="writes-heading">
      <h2 id="writes-heading" class="text-3xl">
        What I write about
      </h2>
      <dl class="mt-6 space-y-6">
        {ABOUT.writesAbout.map((topic) => (
          <div>
            <dt class="font-serif text-xl text-heading">{topic.title}</dt>
            <dd class="mt-1 text-muted">{topic.text}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-6">
        <a href="/blog/" class="link-grow text-accent">
          Read the blog
        </a>
      </p>
    </section>

    <section class="reveal mt-16" aria-labelledby="email-heading">
        <h2 id="writes-heading" class="text-3xl mb-6">
            Contact with Email
        </h2>

        <a
        href={`mailto:${AUTHOR.email}`}
        class="inline-flex items-center gap-3 font-serif text-2xl text-heading underline decoration-accent/50 underline-offset-4 hover:decoration-accent sm:text-3xl"
        >
        <Icon name="mail" class="size-6 text-accent" />
        {AUTHOR.email}
        </a>
        <p class="mt-3 text-muted">
        I read everything and reply when I can, usually within a few days.
        </p>
    </section>

    <section class="mt-6" aria-labelledby="social-heading">
        <h3 id="social-heading" class="eyebrow mb-3">
        Elsewhere
        </h3>
        <SocialLinks variant="list" />
    </section>

  </div>
</BaseLayout>
