---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/lora';
import '@fontsource-variable/lora/wght-italic.css';
import { getImage } from 'astro:assets';
import { ACHIEVEMENTS, AUTHOR, EXPERIENCE, SKILLS, SOCIALS } from '../config';
import { getProjects, projectUrl } from '../utils/posts';

const norm = (ym: string) => ym.replace(/-(\d)$/, '-0$1');
const fmt = (ym: string) => {
  const [y, m] = norm(ym).split('-').map(Number);
  return new Date(Date.UTC(y, m - 1, 1)).toLocaleDateString('en-US', {
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  });
};

// Projects: real thumbnails, optimised at build time.
const projects = await Promise.all(
  (await getProjects()).slice(0, 4).map(async (p, i) => {
    const img = await getImage({ src: p.data.thumbnail.image, width: 1400, format: 'webp' });
    return {
      n: String(i + 1).padStart(2, '0'),
      title: p.data.title,
      summary: p.data.summary,
      status: p.data.status,
      year: p.data.date.getUTCFullYear(),
      stack: p.data.techStack.slice(0, 4).join(' · '),
      href: projectUrl(p),
      img,
      alt: p.data.thumbnail.alt,
    };
  }),
);

// Experience: every role keeps its full bullet list for the expandable rows.
const experience = EXPERIENCE.slice(0, 5).map((e, i) => {
  const starts = e.roles.map((r) => norm(r.startDate)).sort();
  const ongoing = e.roles.some((r) => r.endDate === null);
  const ends = e.roles.map((r) => norm(r.endDate ?? '')).sort();
  return {
    id: `exp-${i}`,
    company: e.company,
    url: e.companyUrl,
    location: e.location,
    range: `${fmt(starts[0])} – ${ongoing ? 'Present' : fmt(ends[ends.length - 1])}`,
    roles: e.roles.map((r) => ({
      title: r.title,
      type: r.employmentType,
      range: `${fmt(r.startDate)} – ${r.endDate ? fmt(r.endDate) : 'Present'}`,
      bullets: r.description.split('•').map((s) => s.trim()).filter(Boolean),
    })),
  };
});

const description = `${AUTHOR.name}, ${AUTHOR.jobTitle}. ${AUTHOR.bio}`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Perdi — Software Engineer</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" />
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <div class="frame">
      <header class="row masthead">
        <div class="cell"><span class="mark">Perdi</span></div>
        <div class="cell cell-clock label">
          <span class="dot" aria-hidden="true"></span>
          <span>Makassar <time id="clock" class="tnum">--:--</time></span>
        </div>
        <div class="cell cell-mail">
          <a class="ulink" href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a>
        </div>
        <div class="cell cell-theme">
          <button id="theme" class="icon-btn" type="button" aria-label="Switch to dark mode" aria-pressed="false">
            <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
            </svg>
            <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5z"></path>
            </svg>
          </button>
        </div>
      </header>

      <main id="main">
        <!-- Hero -->
        <section class="row hero" aria-labelledby="h1">
          <div class="cell hero-copy">
            <p class="label rise" style="--d:0ms">{AUTHOR.jobTitle} · Indonesia</p>
            <h1 id="h1" class="rise" style="--d:70ms">
              Software built to be <em>quiet</em>, fast and easy to trust.
            </h1>
            <p class="lede rise" style="--d:150ms">
              {AUTHOR.bio} I work across web, mobile and backend, from the database to the last pixel.
            </p>
            <div class="actions rise" style="--d:220ms">
              <a class="btn btn-solid" href="#work">See selected work</a>
              <a class="btn" href={`mailto:${AUTHOR.email}`}>Send an email</a>
            </div>
          </div>
          <aside class="cell hero-facts" aria-label="At a glance">
            <dl>
              <div class="fact rise" style="--d:260ms">
                <dt class="label">Experience</dt>
                <dd>4+ years</dd>
              </div>
              <div class="fact rise" style="--d:300ms">
                <dt class="label">Focus</dt>
                <dd>Fullstack, Mobile</dd>
              </div>
              <div class="fact rise" style="--d:340ms">
                <dt class="label">Based in</dt>
                <dd>Makassar, ID</dd>
              </div>
              <div class="fact rise" style="--d:380ms">
                <dt class="label">Elsewhere</dt>
                <dd class="links">
                  {SOCIALS.map((s) => (
                    <a class="ulink" href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a>
                  ))}
                </dd>
              </div>
            </dl>
          </aside>
        </section>

        <!-- Selected work -->
        <section id="work" class="section" aria-labelledby="work-h">
          <div class="row">
            <div class="cell sec-head">
              <span class="label">01</span>
              <h2 id="work-h">Selected work</h2>
            </div>
          </div>
          <ul class="projects" style={`--n:${projects.length}`}>
            {projects.map((p, i) => (
              <li class:list={['proj', i === 0 && 'is-active']}>
                <a class="p-row" href={p.href}>
                  <span class="p-num label">{p.n}</span>
                  <span class="p-main">
                    <span class="p-title">{p.title}</span>
                    <span class="p-sum">{p.summary}</span>
                    <span class="p-stack">{p.stack}</span>
                  </span>
                  <span class="p-meta label">{p.status}<br />{p.year}</span>
                </a>
                <a class="p-view" href={p.href} tabindex="-1" aria-hidden="true">
                  <span class="p-frame">
                    <img
                      src={p.img.src}
                      alt=""
                      width={p.img.attributes.width}
                      height={p.img.attributes.height}
                      loading={i === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                    <span class="p-open label">View project ↗</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>

        <!-- Experience -->
        <section class="section" aria-labelledby="exp-h">
          <div class="row">
            <div class="cell sec-head">
              <span class="label">02</span>
              <h2 id="exp-h">Experience</h2>
            </div>
          </div>
          <ol class="acc">
            {experience.map((e, i) => (
              <li class="acc-item" data-open={i === 0 ? 'true' : 'false'}>
                <h3>
                  <button class="row tr acc-btn" type="button" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={e.id}>
                    <span class="cell td-when label">{e.range}</span>
                    <span class="cell td-who">
                      <span class="td-name">{e.company}</span>
                      <span class="label">{e.location}</span>
                    </span>
                    <span class="cell td-what">
                      <span class="role">{e.roles.map((r) => r.title).join(' / ')}</span>
                      <span class="plus" aria-hidden="true"></span>
                    </span>
                  </button>
                </h3>
                <div class="acc-panel" id={e.id} role="region">
                  <div class="acc-clip">
                    <div class="row tr acc-body">
                      <div class="cell"></div>
                      <div class="cell">
                        {e.url && (
                          <a class="ulink label" href={e.url} target="_blank" rel="noopener noreferrer">Visit website ↗</a>
                        )}
                      </div>
                      <div class="cell roles">
                        {e.roles.map((r) => (
                          <div class="role-block">
                            <p class="role">{r.title}</p>
                            <p class="label">{[r.type, r.range].filter(Boolean).join(' · ')}</p>
                            <ul class="bullets">
                              {r.bullets.map((b) => <li>{b}</li>)}
                            </ul>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>
              </li>
            ))}
          </ol>
        </section>

        <!-- Skills -->
        <section class="section" aria-labelledby="skills-h">
          <div class="row">
            <div class="cell sec-head">
              <span class="label">03</span>
              <h2 id="skills-h">Capabilities</h2>
            </div>
          </div>
          <ul class="row skills">
            {SKILLS.map((g) => (
              <li class="cell skill">
                <h3>{g.title}</h3>
                <p class="muted">{g.description}</p>
                <ul class="chips">
                  {g.skills.map((s) => <li>{s}</li>)}
                </ul>
              </li>
            ))}
          </ul>
        </section>

        <!-- Recognition -->
        <section class="section" aria-labelledby="ach-h">
          <div class="row">
            <div class="cell sec-head">
              <span class="label">04</span>
              <h2 id="ach-h">Recognition</h2>
            </div>
          </div>
          <ul class="table">
            {ACHIEVEMENTS.slice(0, 4).map((a) => (
              <li class="row tr wide-row">
                <div class="cell td-when label">{a.date}</div>
                <div class="cell td-who">
                  <h3 class="td-name">{a.title}</h3>
                  <p class="label">{a.description}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>

        <!-- Contact -->
        <section class="section" aria-labelledby="contact-h">
          <div class="row contact">
            <div class="cell contact-copy">
              <span class="label">05 · Contact</span>
              <h2 id="contact-h">Have something worth building?</h2>
              <a class="btn btn-solid" href={`mailto:${AUTHOR.email}`}>Start a conversation</a>
            </div>
          </div>
        </section>
      </main>

      <footer class="row foot">
        <div class="cell label">© {year} {AUTHOR.name}</div>
        <div class="cell label foot-r">Designed and built by hand</div>
      </footer>
    </div>

    <script>
      // Theme toggle
      const root = document.documentElement;
      const themeBtn = document.getElementById('theme') as HTMLButtonElement;
      const syncTheme = () => {
        const dark = root.dataset.theme === 'dark';
        themeBtn.setAttribute('aria-pressed', String(dark));
        themeBtn.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
      };
      syncTheme();
      themeBtn.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.classList.add('theme-anim');
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
        syncTheme();
        setTimeout(() => root.classList.remove('theme-anim'), 350);
      });

      // Local time
      const clock = document.getElementById('clock');
      const fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Makassar' });
      const tick = () => { if (clock) clock.textContent = fmt.format(new Date()) + ' WITA'; };
      tick();
      setInterval(tick, 15000);

      // Projects: the row under the pointer or focus drives the preview.
      const projs = [...document.querySelectorAll<HTMLElement>('.proj')];
      const activate = (el: HTMLElement) => {
        if (el.classList.contains('is-active')) return;
        projs.forEach((p) => p.classList.toggle('is-active', p === el));
      };
      projs.forEach((el) => {
        const row = el.querySelector('.p-row') as HTMLElement;
        row.addEventListener('pointerenter', (e) => { if ((e as PointerEvent).pointerType === 'mouse') activate(el); });
        row.addEventListener('focus', () => activate(el));
      });

      // Experience accordion
      document.querySelectorAll<HTMLButtonElement>('.acc-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const item = btn.closest('.acc-item') as HTMLElement;
          const open = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!open));
          item.dataset.open = String(!open);
        });
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    --serif: 'Lora Variable', Georgia, serif;
    --sans: 'Inter Variable', system-ui, sans-serif;
    --mono: 'JetBrains Mono Variable', ui-monospace, monospace;
    --pad: clamp(1.5rem, 4vw, 3.5rem);
  }
  :root,
  [data-theme='light'] {
    --bg: #fbfaf8;
    --ink: #17171a;
    --muted: #6a6a70;
    --faint: #a4a29b;
    --line: #dcdad4;
    --line-strong: #bdbab2;
    --hover: #f3f1ec;
    --accent: #0b6b52;
    color-scheme: light;
  }
  [data-theme='dark'] {
    --bg: #0d0d0f;
    --ink: #ececea;
    --muted: #94949a;
    --faint: #5b5b61;
    --line: #26262a;
    --line-strong: #3a3a40;
    --hover: #141417;
    --accent: #6ee7b7;
    color-scheme: dark;
  }
  .theme-anim,
  .theme-anim *,
  .theme-anim *::before,
  .theme-anim *::after {
    transition: background-color 280ms ease, color 280ms ease, border-color 280ms ease !important;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body {
    margin: 0; background: var(--bg); color: var(--ink);
    font: 400 1rem/1.65 var(--sans); -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
  }
  h1, h2, h3, p, ul, ol, dl, dd { margin: 0; padding: 0; }
  ul, ol { list-style: none; }
  a { color: inherit; text-decoration: none; }
  button { font: inherit; color: inherit; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .tnum { font-variant-numeric: tabular-nums; }

  .skip { position: absolute; left: 1rem; top: -4rem; z-index: 10; background: var(--ink); color: var(--bg); padding: 0.6rem 1rem; font-size: 0.875rem; }
  .skip:focus { top: 1rem; }

  /* ---- Grid frame ---- */
  .frame { max-width: 84rem; margin: 0 auto; min-height: 100dvh; border-inline: 1px solid var(--line); position: relative; }
  .row { display: grid; border-bottom: 1px solid var(--line); }
  .cell { padding: var(--pad); min-width: 0; position: relative; display: block; }
  .row > .cell + .cell { border-left: 1px solid var(--line); }

  .section > .row:first-child .cell::before,
  .hero::before {
    content: '+'; position: absolute; top: -0.62em; left: -0.34em;
    font: 300 1rem/1 var(--mono); color: var(--line-strong); pointer-events: none;
  }
  .hero { position: relative; }
  .hero::before { top: auto; bottom: -0.62em; }

  .label { font: 500 0.6875rem/1.5 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .muted { color: var(--muted); }
  h1, h2, h3 { font-family: var(--serif); font-weight: 450; letter-spacing: -0.015em; text-wrap: balance; }
  em { font-style: italic; color: var(--accent); }

  /* ---- Masthead ---- */
  .masthead { grid-template-columns: 1fr auto auto auto; align-items: stretch; }
  .masthead .cell { padding-block: 1.1rem; display: flex; align-items: center; }
  .mark { font: 500 1.125rem/1 var(--serif); letter-spacing: -0.01em; }
  .cell-clock { gap: 0.6rem; }
  .cell-mail { font-size: 0.875rem; }
  .cell-theme { padding-inline: 1.1rem !important; }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 50%, transparent); animation: ping 2.8s var(--ease-out) infinite; }
  @keyframes ping { 70%, 100% { box-shadow: 0 0 0 7px transparent; } }

  .icon-btn {
    position: relative; display: grid; place-items: center; width: 2.5rem; height: 2.5rem;
    background: none; border: 1px solid var(--line-strong); cursor: pointer; color: var(--ink);
    transition: transform 160ms var(--ease-out), background-color 160ms ease, border-color 160ms ease;
  }
  .icon-btn:active { transform: scale(0.95); }
  .icon-btn svg { grid-area: 1 / 1; transition: opacity 200ms ease, transform 300ms var(--ease-out); }
  [data-theme='light'] .i-moon, [data-theme='dark'] .i-sun { opacity: 0; transform: rotate(-60deg) scale(0.6); }

  /* ---- Hero ---- */
  .hero { grid-template-columns: minmax(0, 1.9fr) minmax(0, 1fr); }
  .hero-copy { padding-block: clamp(5rem, 15vw, 12rem) clamp(4rem, 9vw, 7.5rem); display: flex; flex-direction: column; align-items: flex-start; gap: 2rem; }
  h1 { font-size: clamp(2.6rem, 6.6vw, 5.75rem); line-height: 1.03; max-width: 15ch; }
  .lede { max-width: 52ch; color: var(--muted); font-size: 1.125rem; text-wrap: pretty; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.75rem; }
  .hero-facts { padding: 0; }
  .hero-facts dl { display: grid; height: 100%; grid-auto-rows: 1fr; }
  .fact { padding: var(--pad); display: flex; flex-direction: column; justify-content: center; gap: 0.5rem; }
  .fact + .fact { border-top: 1px solid var(--line); }
  .fact dd { font: 450 1.375rem/1.3 var(--serif); }
  .fact .links { display: flex; flex-wrap: wrap; gap: 0.25rem 1.5rem; font: 400 0.9375rem/1.4 var(--sans); }

  /* ---- Buttons & links ---- */
  .btn {
    display: inline-flex; align-items: center; height: 3rem; padding: 0 1.5rem;
    border: 1px solid var(--line-strong); font-size: 0.875rem; font-weight: 500;
    transition: transform 160ms var(--ease-out), background-color 160ms ease, color 160ms ease, border-color 160ms ease;
  }
  .btn-solid { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .btn:active { transform: scale(0.97); }
  .ulink { background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: background-size 220ms var(--ease-out); padding-bottom: 1px; }

  /* ---- Sections ---- */
  .section { position: relative; }
  .sec-head { display: flex; align-items: baseline; gap: 1.25rem; padding-block: 1.75rem; }
  .sec-head h2 { font: 450 1.0625rem/1.2 var(--sans); letter-spacing: 0; }

  /* ---- Projects: list + sticky preview ---- */
  .projects {
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    grid-template-rows: repeat(var(--n), auto); border-bottom: 1px solid var(--line);
  }
  .proj { display: contents; }
  .p-row {
    grid-column: 1; display: grid; grid-template-columns: 2.5rem 1fr auto; gap: 1rem;
    padding: clamp(2rem, 4vw, 3.25rem) var(--pad); border-bottom: 1px solid var(--line);
    position: relative; color: var(--muted); transition: color 240ms ease, background-color 240ms ease;
  }
  .proj:last-child .p-row { border-bottom: 0; }
  .p-row::before {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 2px; background: var(--accent);
    transform: scaleY(0); transform-origin: top; transition: transform 320ms var(--ease-out);
  }
  .proj.is-active .p-row { color: var(--ink); }
  .proj.is-active .p-row::before { transform: scaleY(1); }
  .p-main { display: flex; flex-direction: column; gap: 0.9rem; min-width: 0; }
  .p-title { font: 450 clamp(1.5rem, 2.6vw, 2.25rem)/1.15 var(--serif); letter-spacing: -0.015em; text-wrap: balance; }
  .p-sum { font-size: 0.9375rem; color: var(--muted); max-width: 44ch; text-wrap: pretty; }
  .p-stack { font: 400 0.75rem/1.5 var(--mono); color: var(--faint); margin-top: 0.25rem; transition: color 240ms ease; }
  .proj.is-active .p-stack { color: var(--muted); }
  .p-meta { text-align: right; white-space: nowrap; }
  .p-num { padding-top: 0.55rem; }

  .p-view { grid-column: 2; grid-row: 1 / span var(--n); border-left: 1px solid var(--line); display: block; pointer-events: none; }
  .p-frame {
    position: sticky; top: 0; display: block; margin: var(--pad);
    aspect-ratio: 4 / 3; max-height: calc(100dvh - 2 * var(--pad)); overflow: hidden;
    border: 1px solid var(--line); background: var(--hover);
    opacity: 0; transform: scale(0.985); filter: blur(4px);
    transition: opacity 280ms var(--ease-out), transform 480ms var(--ease-out), filter 280ms var(--ease-out);
  }
  .p-frame img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .p-open {
    position: absolute; right: 1rem; bottom: 1rem; padding: 0.45rem 0.7rem;
    background: var(--bg); color: var(--ink); border: 1px solid var(--line-strong);
    opacity: 0; transform: translateY(6px); transition: opacity 200ms ease, transform 240ms var(--ease-out);
  }
  .proj.is-active .p-view { pointer-events: auto; }
  .proj.is-active .p-frame { opacity: 1; transform: none; filter: none; }

  /* ---- Tables ---- */
  .tr { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr) minmax(0, 2.2fr); }
  .wide-row { grid-template-columns: minmax(0, 1fr) minmax(0, 3.6fr); transition: background-color 200ms ease; }
  .td-when { padding-top: calc(var(--pad) + 0.35rem); font-variant-numeric: tabular-nums; }
  .td-name { display: block; font: 450 1.375rem/1.25 var(--serif); letter-spacing: -0.015em; }
  .td-who .label { display: block; margin-top: 0.5rem; }
  .role { font-weight: 500; font-size: 0.9375rem; }

  /* ---- Experience accordion ---- */
  .acc-item { border-bottom: 1px solid var(--line); }
  .acc-item h3 { font: inherit; letter-spacing: 0; }
  .acc-btn { width: 100%; border: 0; background: none; text-align: left; cursor: pointer; padding: 0; transition: background-color 200ms ease; }
  .acc-btn .td-what { padding-right: calc(var(--pad) + 2rem); padding-top: calc(var(--pad) + 0.35rem); }
