---
import FoundationLayout from '../../layouts/FoundationLayout.astro';
import Tags from '../../components/Tags.astro';
import { breadcrumbJsonLd } from '../../utils/jsonld';
import { getPosts } from '../../utils/posts';
import { getTags } from '../../utils/taxonomy';

const tags = getTags(await getPosts());
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Tags', href: '/tags/' },
];
---

<FoundationLayout
  title="Tags"
  description="Every topic covered on the blog, with the number of articles for each tag."
  ownHeading
  seo={{ jsonLd: [breadcrumbJsonLd(Astro.site!, crumbs)] }}
>
  <Tags tags={tags} />
</FoundationLayout>
