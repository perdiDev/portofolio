---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/lora';
import '@fontsource-variable/lora/wght-italic.css';
import { getImage } from 'astro:assets';
import photo from '../assets/photo.jpeg';
import { ACHIEVEMENTS, AUTHOR, EXPERIENCE, SKILLS, SOCIALS } from '../config';
import { getProjects, projectUrl } from '../utils/posts';

const norm = (ym: string) => ym.replace(/-(\d)$/, '-0$1');
const fmt = (ym: string) => {
  const [y, m] = norm(ym).split('-').map(Number);
  return new Date(Date.UTC(y, m - 1, 1)).toLocaleDateString('en-US', {
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  });
};

const portrait = await getImage({ src: photo, width: 900, format: 'webp' });

const projects = await Promise.all(
  (await getProjects()).slice(0, 4).map(async (p, i) => ({
    n: String(i + 1).padStart(2, '0'),
    title: p.data.title,
    summary: p.data.summary,
    status: p.data.status,
    year: p.data.date.getUTCFullYear(),
    stack: p.data.techStack.slice(0, 4).join(' · '),
    href: projectUrl(p),
    img: await getImage({ src: p.data.thumbnail.image, width: 1200, format: 'webp' }),
    alt: p.data.thumbnail.alt,
  })),
);

const experience = EXPERIENCE.slice(0, 5).map((e, i) => {
  const starts = e.roles.map((r) => norm(r.startDate)).sort();
  const ongoing = e.roles.some((r) => r.endDate === null);
  const ends = e.roles.map((r) => norm(r.endDate ?? '')).sort();
  return {
    id: `exp-${i}`,
    company: e.company,
    url: e.companyUrl,
    location: e.location,
    range: `${fmt(starts[0])} – ${ongoing ? 'Present' : fmt(ends[ends.length - 1])}`,
    titles: e.roles.map((r) => r.title).join(' / '),
    roles: e.roles.map((r) => ({
      title: r.title,
      meta: [r.employmentType, `${fmt(r.startDate)} – ${r.endDate ? fmt(r.endDate) : 'Present'}`]
        .filter(Boolean)
        .join(' · '),
      bullets: r.description.split('•').map((s) => s.trim()).filter(Boolean),
    })),
  };
});

const nav = [
  ['about', 'Introduction'],
  ['work', 'Selected work'],
  ['experience', 'Experience'],
  ['craft', 'Capabilities'],
  ['recognition', 'Recognition'],
  ['contact', 'Contact'],
] as const;

const description = `${AUTHOR.name}, ${AUTHOR.jobTitle}. ${AUTHOR.bio}`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Perdi — Software Engineer</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" />
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#about">Skip to content</a>

    <div class="shell">
      <!-- Side rail -->
      <aside class="rail">
        <div class="rail-top">
          <a class="brand" href="#about">Perdi</a>
          <p class="role-line">{AUTHOR.jobTitle}</p>
        </div>

        <nav class="toc" aria-label="Sections">
          <ol>
            {nav.map(([id, label], i) => (
              <li>
                <a href={`#${id}`} data-target={id} aria-current={i === 0 ? 'true' : undefined}>
                  <span class="toc-n">{String(i + 1).padStart(2, '0')}</span>
                  <span class="toc-l">{label}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>

        <div class="rail-foot">
          <p class="clock"><span class="dot" aria-hidden="true"></span> Makassar <time id="clock" class="tnum">--:--</time></p>
          <button id="theme" class="theme" type="button" aria-label="Switch to dark mode" aria-pressed="false">
            <svg class="i-sun" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
            </svg>
            <svg class="i-moon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5z"></path>
            </svg>
          </button>
        </div>
      </aside>

      <main class="main">
        <!-- 01 Introduction -->
        <section id="about" class="hero" aria-labelledby="h1">
          <div class="hero-text">
            <p class="eyebrow rise" style="--d:0ms">Software engineer · Indonesia</p>
            <h1 id="h1" class="rise" style="--d:80ms">
              Software that stays <em>out of the way</em> and keeps its promises.
            </h1>
            <p class="lede rise" style="--d:170ms">
              {AUTHOR.bio} I work across web, mobile and backend, from the database to the last pixel.
            </p>
            <p class="links rise" style="--d:240ms">
              <a class="btn" href="#work">View selected work</a>
              {SOCIALS.map((s) => (
                <a class="ulink" href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a>
              ))}
            </p>
          </div>
          <figure class="portrait rise" style="--d:200ms">
            <img src={portrait.src} width={portrait.attributes.width} height={portrait.attributes.height} alt="Portrait of Perdi" fetchpriority="high" decoding="async" />
          </figure>
        </section>

        <!-- 02 Selected work -->
        <section id="work" class="sec" aria-labelledby="work-h">
          <header class="sec-head">
            <div>
              <p class="sec-n">02</p>
              <h2 id="work-h">Selected work</h2>
            </div>
            <div class="pager" aria-label="Browse projects">
              <span class="count tnum" aria-live="polite"><b id="cur">01</b> / {String(projects.length).padStart(2, '0')}</span>
              <button class="arrow" id="prev" type="button" aria-label="Previous project">←</button>
              <button class="arrow" id="next" type="button" aria-label="Next project">→</button>
            </div>
          </header>

          <ul class="track" id="track" tabindex="0" aria-label="Projects">
            {projects.map((p) => (
              <li class="plate">
                <a class="plate-link" href={p.href}>
                  <span class="mat">
                    <img src={p.img.src} width={p.img.attributes.width} height={p.img.attributes.height} alt={p.alt} loading="lazy" decoding="async" />
                  </span>
                  <span class="plate-meta">
                    <span class="plate-no">No. {p.n}</span>
                    <span class="plate-status">{p.status} · {p.year}</span>
                  </span>
                  <span class="plate-title">{p.title}</span>
                  <span class="plate-sum">{p.summary}</span>
                  <span class="plate-stack">{p.stack}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>

        <!-- 03 Experience -->
        <section id="experience" class="sec" aria-labelledby="exp-h">
          <header class="sec-head">
            <div>
              <p class="sec-n">03</p>
              <h2 id="exp-h">Experience</h2>
            </div>
          </header>
          <ol class="exp">
            {experience.map((e, i) => (
              <li class="exp-item" data-open={i === 0 ? 'true' : 'false'}>
                <h3>
                  <button class="exp-btn" type="button" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={e.id}>
                    <span class="exp-when tnum">{e.range}</span>
                    <span class="exp-main">
                      <span class="exp-co">{e.company}</span>
                      <span class="exp-role">{e.titles}</span>
                    </span>
                    <span class="exp-icon" aria-hidden="true"></span>
                  </button>
                </h3>
                <div class="exp-panel" id={e.id} role="region">
                  <div class="exp-clip">
                    <div class="exp-body">
                      {e.location && <p class="small">{e.location}</p>}
                      {e.roles.map((r) => (
                        <div class="exp-roleblock">
                          <p class="exp-rt">{r.title}</p>
                          <p class="small">{r.meta}</p>
                          <ul class="bullets">
                            {r.bullets.map((b) => <li>{b}</li>)}
                          </ul>
                        </div>
                      ))}
                      {e.url && (
                        <a class="ulink small" href={e.url} target="_blank" rel="noopener noreferrer">Visit website ↗</a>
                      )}
                    </div>
                  </div>
                </div>
              </li>
            ))}
          </ol>
        </section>

        <!-- 04 Capabilities -->
        <section id="craft" class="sec" aria-labelledby="craft-h">
          <header class="sec-head">
            <div>
              <p class="sec-n">04</p>
              <h2 id="craft-h">Capabilities</h2>
            </div>
          </header>
          <ul class="craft">
            {SKILLS.map((g) => (
              <li class="craft-row">
                <h3>{g.title}</h3>
                <div>
                  <p class="craft-desc">{g.description}</p>
                  <p class="craft-list">{g.skills.join('  ·  ')}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>

        <!-- 05 Recognition -->
        <section id="recognition" class="sec" aria-labelledby="rec-h">
          <header class="sec-head">
            <div>
              <p class="sec-n">05</p>
              <h2 id="rec-h">Recognition</h2>
            </div>
          </header>
          <ul class="rec">
            {ACHIEVEMENTS.slice(0, 4).map((a) => (
              <li class="rec-row">
                <span class="rec-when small tnum">{a.date}</span>
                <div>
                  <h3>{a.title}</h3>
                  <p class="small">{a.description}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>

        <!-- 06 Contact -->
        <section id="contact" class="sec contact" aria-labelledby="contact-h">
          <p class="sec-n">06</p>
          <h2 id="contact-h">Have something worth building?</h2>
          <a class="big-mail ulink" href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a>
          <div class="contact-actions">
            <button id="copy" class="btn" type="button">Copy email</button>
            <span id="copied" class="small" role="status" aria-live="polite"></span>
          </div>
        </section>

        <footer class="foot small">
          <span>© {year} {AUTHOR.name}</span>
          <span>Designed and built by hand</span>
        </footer>
      </main>
    </div>

    <script define:vars={{ email: AUTHOR.email }}>
      const root = document.documentElement;
      const $ = (s, r = document) => r.querySelector(s);
      const $$ = (s, r = document) => [...r.querySelectorAll(s)];

      // Theme
      const themeBtn = $('#theme');
      const syncTheme = () => {
        const dark = root.dataset.theme === 'dark';
        themeBtn.setAttribute('aria-pressed', String(dark));
        themeBtn.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
      };
      syncTheme();
      themeBtn.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.classList.add('theme-anim');
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
        syncTheme();
        setTimeout(() => root.classList.remove('theme-anim'), 350);
      });

      // Local time
      const clock = $('#clock');
      const tf = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Makassar' });
      const tick = () => { clock.textContent = tf.format(new Date()) + ' WITA'; };
      tick();
      setInterval(tick, 15000);

      // Table of contents follows the section in view
      const links = $$('.toc a');
      const map = new Map(links.map((a) => [a.dataset.target, a]));
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((en) => {
            if (en.isIntersecting) {
              links.forEach((a) => {
                if (a.dataset.target === en.target.id) a.setAttribute('aria-current', 'true');
                else a.removeAttribute('aria-current');
              });
            }
          });
        },
        { rootMargin: '-40% 0px -55% 0px' },
      );
      $$('main section[id]').forEach((s) => map.has(s.id) && io.observe(s));

      // Project track
      const track = $('#track');
      const plates = $$('.plate', track);
      const cur = $('#cur');
      const step = () => plates[0].getBoundingClientRect().width + parseFloat(getComputedStyle(track).columnGap || 0);
      const index = () => Math.min(plates.length - 1, Math.round(track.scrollLeft / step()));
      const sync = () => {
        const i = index();
        cur.textContent = String(i + 1).padStart(2, '0');
        $('#prev').disabled = track.scrollLeft < 4;
        $('#next').disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      };
      const go = (d) => track.scrollTo({ left: (index() + d) * step(), behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      $('#prev').addEventListener('click', () => go(-1));
      $('#next').addEventListener('click', () => go(1));
      track.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });
      track.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { e.preventDefault(); go(1); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); }
      });
      sync();

      // Experience
      $$('.exp-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const open = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!open));
          btn.closest('.exp-item').dataset.open = String(!open);
        });
      });

      // Copy email
      const copied = $('#copied');
      $('#copy').addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(email);
          copied.textContent = 'Copied to clipboard';
        } catch (e) {
          copied.textContent = 'Press Ctrl+C to copy: ' + email;
        }
        setTimeout(() => (copied.textContent = ''), 2400);
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    --serif: 'Lora Variable', Georgia, serif;
    --sans: 'Inter Variable', system-ui, sans-serif;
    --mono: 'JetBrains Mono Variable', ui-monospace, monospace;
    --rail: 17rem;
    --gutter: clamp(1.5rem, 5vw, 5rem);
  }
  :root,
  [data-theme='light'] {
    --bg: #f4f1ea;
    --bg-2: #ece8df;
    --ink: #1d1b18;
    --muted: #6f6b63;
    --line: #d9d4c8;
    --accent: #8a4a30;
    color-scheme: light;
  }
  [data-theme='dark'] {
    --bg: #141311;
    --bg-2: #1c1a17;
    --ink: #ece7dd;
    --muted: #9a958a;
    --line: #2d2a25;
    --accent: #dba685;
    color-scheme: dark;
  }
  .theme-anim, .theme-anim *, .theme-anim *::before, .theme-anim *::after {
    transition: background-color 280ms ease, color 280ms ease, border-color 280ms ease !important;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; scroll-padding-top: 2rem; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 400 1rem/1.7 var(--sans); -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
  h1, h2, h3, p, ul, ol { margin: 0; padding: 0; }
  ul, ol { list-style: none; }
  a { color: inherit; text-decoration: none; }
  button { font: inherit; color: inherit; }
  img { display: block; max-width: 100%; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .tnum { font-variant-numeric: tabular-nums; }
  .small { font-size: 0.8125rem; color: var(--muted); line-height: 1.6; }
  em { font-style: italic; color: var(--accent); }
  h1, h2, h3 { font-family: var(--serif); font-weight: 400; letter-spacing: -0.02em; text-wrap: balance; }

  .skip { position: absolute; left: 1rem; top: -4rem; z-index: 20; background: var(--ink); color: var(--bg); padding: 0.6rem 1rem; font-size: 0.875rem; }
  .skip:focus { top: 1rem; }

  /* ---- Shell: fixed rail + reading column ---- */
  .shell { display: grid; grid-template-columns: var(--rail) minmax(0, 1fr); min-height: 100dvh; }
  .rail {
    position: sticky; top: 0; height: 100dvh; padding: 2.5rem 2rem 2rem 2.5rem;
    display: flex; flex-direction: column; justify-content: space-between;
    border-right: 1px solid var(--line);
  }
  .brand { font: 500 1.5rem/1 var(--serif); letter-spacing: -0.02em; font-style: italic; }
  .role-line { margin-top: 0.6rem; font-size: 0.8125rem; color: var(--muted); }

  .toc ol { display: grid; gap: 0.15rem; }
  .toc a { display: flex; align-items: baseline; gap: 0.9rem; padding: 0.4rem 0; color: var(--muted); transition: color 200ms ease, transform 240ms var(--ease-out); }
  .toc-n { font: 400 0.6875rem/1 var(--mono); letter-spacing: 0.04em; width: 1.4rem; }
  .toc-l { font-size: 0.9375rem; position: relative; }
  .toc-l::after { content: ''; position: absolute; left: 0; right: 0; bottom: -2px; height: 1px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform 320ms var(--ease-out); }
  .toc a[aria-current] { color: var(--ink); transform: translateX(4px); }
  .toc a[aria-current] .toc-n { color: var(--accent); }
  .toc a[aria-current] .toc-l::after { transform: scaleX(1); }

  .rail-foot { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .clock { display: flex; align-items: center; gap: 0.5rem; font: 400 0.6875rem/1.4 var(--mono); letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 45%, transparent); animation: ping 2.8s var(--ease-out) infinite; }
  @keyframes ping { 70%, 100% { box-shadow: 0 0 0 7px transparent; } }
  .theme { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 50%; border: 1px solid var(--line); background: none; cursor: pointer; transition: transform 160ms var(--ease-out), border-color 160ms ease; }
  .theme:active { transform: scale(0.94); }
  .theme svg { grid-area: 1 / 1; transition: opacity 200ms ease, transform 320ms var(--ease-out); }
  [data-theme='light'] .i-moon, [data-theme='dark'] .i-sun { opacity: 0; transform: rotate(-60deg) scale(0.6); }

  .main { padding: 0 var(--gutter); max-width: 62rem; width: 100%; }

  /* ---- Hero ---- */
  .hero { min-height: 100dvh; display: grid; grid-template-columns: minmax(0, 1fr) minmax(12rem, 20rem); align-items: center; gap: clamp(2rem, 5vw, 5rem); padding-block: 6rem; }
  .hero-text { display: flex; flex-direction: column; gap: 2rem; align-items: flex-start; }
  .eyebrow { font: 400 0.75rem/1.4 var(--mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  h1 { font-size: clamp(2.35rem, 4.4vw, 3.75rem); line-height: 1.1; font-weight: 400; }
  .lede { max-width: 46ch; color: var(--muted); font-size: 1.0625rem; text-wrap: pretty; }
  .links { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; }

  .portrait { margin: 0; aspect-ratio: 3 / 4; border-radius: 999px 999px 0 0; overflow: hidden; background: var(--bg-2); outline: 1px solid var(--line); outline-offset: 10px; }
  .portrait img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; filter: grayscale(1) contrast(1.05) brightness(0.98); transition: filter 600ms var(--ease-out), transform 700ms var(--ease-out); }
  [data-theme='dark'] .portrait img { filter: grayscale(1) contrast(1.05) brightness(0.85); }

  .btn { display: inline-flex; align-items: center; height: 2.875rem; padding: 0 1.5rem; border-radius: 999px; background: var(--ink); color: var(--bg); border: 1px solid var(--ink); font-size: 0.875rem; font-weight: 500; cursor: pointer; transition: transform 160ms var(--ease-out), background-color 160ms ease, border-color 160ms ease; }
  .btn:active { transform: scale(0.97); }
  .ulink { background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat; background-size: 0 1px; transition: background-size 260ms var(--ease-out); padding-bottom: 2px; }
  .links .ulink { font-size: 0.9375rem; }

  /* ---- Section scaffold ---- */
  .sec { padding-block: clamp(5rem, 11vw, 9rem); border-top: 1px solid var(--line); }
  .sec-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .sec-n { font: 400 0.75rem/1 var(--mono); letter-spacing: 0.08em; color: var(--accent); margin-bottom: 1rem; }
  .sec h2 { font-size: clamp(2rem, 3.8vw, 3.25rem); line-height: 1.08; }

  /* ---- Projects: horizontal plates ---- */
  .pager { display: flex; align-items: center; gap: 0.6rem; }
  .count { font: 400 0.75rem/1 var(--mono); letter-spacing: 0.06em; color: var(--muted); margin-right: 0.75rem; }
  .count b { color: var(--ink); font-weight: 500; }
  .arrow { width: 2.75rem; height: 2.75rem; border-radius: 50%; border: 1px solid var(--line); background: none; cursor: pointer; font-size: 1rem; transition: transform 160ms var(--ease-out), border-color 160ms ease, opacity 200ms ease; }
  .arrow:active:not(:disabled) { transform: scale(0.94); }
  .arrow:disabled { opacity: 0.3; cursor: default; }

  .track {
    display: flex; gap: clamp(1.5rem, 3vw, 2.5rem); overflow-x: auto; scroll-snap-type: x mandatory;
    margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); scroll-padding-inline: var(--gutter);
    scrollbar-width: none; overscroll-behavior-x: contain;
  }
  .track::-webkit-scrollbar { display: none; }
  .plate { flex: 0 0 min(34rem, 82%); scroll-snap-align: start; }
  .plate-link { display: flex; flex-direction: column; gap: 0.85rem; height: 100%; }
  .mat { display: block; padding: 0.75rem; background: var(--bg-2); border: 1px solid var(--line); overflow: hidden; margin-bottom: 0.5rem; }
  .mat img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: top center; transition: transform 600ms var(--ease-out); }
