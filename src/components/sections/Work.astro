---
/**
 * Work: one row per project. A ruled head (number, title, status, summary) over a plate:
 * a tinted stage with a line drawing from the project's subject and its real screens.
 * Each card is one link, named by its own content; the stack dock is decorative and read
 * from a visually hidden sentence instead.
 */
import '../../styles/work.css';
import Section from '../foundation/Section.astro';
import ProjectPlate from './ProjectPlate.astro';
import { getProjects, projectUrl } from '../../utils/posts';

interface Props {
  id: string;
  title: string;
  /** How many projects to show, newest first. */
  limit?: number;
}

const { id, title, limit = 7 } = Astro.props;
const STACK_SHOWN = 5;

const projects = (await getProjects()).slice(0, limit).map((p, i) => {
  const stack = p.data.techStack.slice(0, STACK_SHOWN);
  const more = Math.max(0, p.data.techStack.length - STACK_SHOWN);
  return {
    project: p,
    n: String(i + 1).padStart(2, '0'),
    title: p.data.title,
    summary: p.data.summary,
    status: p.data.status,
    year: p.data.date.getUTCFullYear(),
    stackText: `Built with ${stack.join(', ')}${more ? ` and ${more} more` : ''}.`,
    hasStack: stack.length > 0,
    href: projectUrl(p),
  };
});
---

<Section id={id} title={title} class="band" bare>
  <ul class="grid" data-work>
    {projects.map((p, i) => (
      <li class="card reveal">
        <a class="card-link" href={p.href} data-cursor>
          <span class="card-head">
            <span class="card-left">
              <span class="card-title">
                <span class="card-no tnum">{p.n}</span>
                <span>{p.title}</span>
              </span>
              <span class="card-status">
                {p.status} · {p.year}
              </span>
            </span>
            <span class="card-sum">{p.summary}</span>
          </span>
          <ProjectPlate project={p.project} dock eager={i === 0} />
          {p.hasStack && <span class="sr">{p.stackText}</span>}
        </a>
      </li>
    ))}
  </ul>
</Section>

<script>
  import '../../scripts/work';
</script>
