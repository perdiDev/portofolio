---
import type { Post } from '../utils/posts';
import { postUrl, readingTimeOf } from '../utils/posts';
import FormattedDate from './FormattedDate.astro';
import Tag from './Tag.astro';

interface Props {
  post: Post;
  /** Heading level of the title, to keep the outline sequential. */
  as?: 'h2' | 'h3';
  /** Position in the list, drives the staggered entrance. */
  index?: number;
  showTags?: boolean;
}

const { post, as: Heading = 'h2', index = 0, showTags = true } = Astro.props;
const { title, description, pubDate, category, tags, draft } = post.data;
const reading = readingTimeOf(post);
---

<article class="fade-up" style={`--i:${index}`}>
  <div class="meta flex flex-wrap items-center gap-x-2 gap-y-1">
    <Tag name={category} kind="category" />
    <FormattedDate date={pubDate} />
    <span aria-hidden="true">·</span>
    <span>{reading.text}</span>
    {draft && <span class="chip border-amber-400/60 text-amber-300">Draft</span>}
  </div>
  <Heading class="mt-2 text-2xl leading-snug sm:text-[1.7rem]">
    <a href={postUrl(post)} class="link-grow">
      {title}
    </a>
  </Heading>
  <p class="mt-2 text-pretty text-muted">{description}</p>
  {showTags && (
    <ul class="mt-3 flex flex-wrap gap-2" aria-label="Tags">
      {tags.map((tag) => (
        <li>
          <Tag name={tag} kind="tag" />
        </li>
      ))}
    </ul>
  )}
</article>
