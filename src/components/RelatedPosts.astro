---
import type { Post } from '../utils/posts';
import { postUrl } from '../utils/posts';
import Icon from './Icon.astro';

interface Props {
  posts: Post[];
  heading?: string;
  id?: string;
}

const { posts, heading = 'Related articles', id = 'related-heading' } = Astro.props;
---

{posts.length > 0 && (
  <section aria-labelledby={id} class="reveal" data-pagefind-ignore>
    <h2 id={id} class="mb-6 text-2xl">
      {heading}
    </h2>
    <ul class="divide-y divide-border border-y border-border">
      {posts.map((post) => (
        <li>
          <a href={postUrl(post)} class="row-link group flex items-baseline gap-5 py-3.5">
            <span class="meta w-32 shrink-0 whitespace-nowrap">{post.data.category}</span>
            <span class="grow text-heading">{post.data.title}</span>
            <Icon name="arrow-right" class="row-arrow size-4 text-accent" />
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
