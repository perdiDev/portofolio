---
/**
 * Journey: an accordion timeline. Dates on the left, a spine that fills as the page is read,
 * one row per company; the first row starts open.
 */
import '../styles/experience.css';
import Section from './foundation/Section.astro';
import { EXPERIENCE } from '../config';
import { toTimeline } from '../utils/timeline';

interface Props {
  id: string;
  n: string;
  title: string;
  /** How many companies to show, newest first. */
  limit?: number;
}

const { id, n, title, limit = 5 } = Astro.props;
const rows = toTimeline(EXPERIENCE.slice(0, limit), `${id}-row`);
---

<Section id={id} n={n} title={title}>
  <ol class="exp" data-timeline>
    {rows.map((e, i) => {
      const open = i === 0 ? 'true' : 'false';
      return (
        <li class="exp-item reveal" style={`--i:${i}`} data-open={open}>
          <h3>
            <button
              class="exp-btn"
              type="button"
              id={`${e.id}-btn`}
              aria-expanded={open}
              aria-controls={e.id}
            >
              <span class="exp-when tnum">
                <span class="exp-range">
                  {e.ongoing && <i class="dot" aria-hidden="true" />}
                  {e.range}
                </span>
                <span class="exp-span">{e.span}</span>
              </span>
              <span class="exp-main">
                <span class="exp-co">{e.company}</span>
                <span class="exp-role">{e.titles}</span>
              </span>
              <span class="exp-icon" aria-hidden="true" />
            </button>
          </h3>
          <div class="exp-panel" id={e.id} role="region" aria-labelledby={`${e.id}-btn`}>
            <div class="exp-clip">
              <div class="exp-body">
                {e.location && (
                  <p class="small" style="--k:0">
                    {e.location}
                  </p>
                )}
                {e.roles.map((r, j) => (
                  <div class="exp-roleblock" style={`--k:${j + 1}`}>
                    <p class="exp-rt">{r.title}</p>
                    <p class="small">{r.meta}</p>
                    <ul class="bullets">
                      {r.bullets.map((b, k) => (
                        <li style={`--b:${k}`}>{b}</li>
                      ))}
                    </ul>
                  </div>
                ))}
                {e.url && (
                  <a
                    class="ulink small"
                    style={`--k:${e.roles.length + 1}`}
                    href={e.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Visit website <span aria-hidden="true">↗</span>
                    <span class="sr">of {e.company} (opens in a new tab)</span>
                  </a>
                )}
              </div>
            </div>
          </div>
        </li>
      );
    })}
  </ol>
</Section>

<script>
  import '../scripts/experience';
</script>
