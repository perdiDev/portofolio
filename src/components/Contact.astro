---
/**
 * Contact: a masked, rising question, the email as the main link, a copy button,
 * an envelope plate whose letter rises on entry, and social links as ruled cells.
 */
import '../styles/contact.css';
import Section from './foundation/Section.astro';
import Icon from './Icon.astro';
import { AUTHOR, SOCIALS } from '../config';

interface Props {
  id: string;
  n: string;
  /** Label in the rail. The section is named by its visible heading, the question below. */
  title: string;
}

const { id, n, title } = Astro.props;
const socials = SOCIALS.map((so) => ({
  ...so,
  handle: new URL(so.url).pathname.split('/').filter(Boolean).pop() ?? so.label,
}));
---

<Section id={id} n={n} title={title} class="contact" headless>
  <div class="contact-grid">
    <div class="contact-copy">
      <p class="sec-n">{n}</p>
      <h2 id={`${id}-h`}>
        <span class="cw">
          <span style="--w:0">Have</span>
        </span>
        <span class="cw">
          <span style="--w:1">something</span>
        </span>
        <span class="cw">
          <span style="--w:2">worth</span>
        </span>
        <span class="cw">
          <em style="--w:3">building?</em>
        </span>
      </h2>
      <a class="big-mail ulink" href={`mailto:${AUTHOR.email}`}>
        <span class="mail-t">{AUTHOR.email}</span>
        <svg
          class="mail-arrow"
          viewBox="0 0 24 24"
          width="1em"
          height="1em"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M7 17 17 7M8 7h9v9"></path>
        </svg>
      </a>
      <div class="contact-actions">
        <button id="copy" class="btn" type="button" data-state="idle" data-email={AUTHOR.email}>
          <span class="btn-roll">
            <span class="btn-a">Copy email</span>
            <span class="btn-b" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="15"
                height="15"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path pathLength="1" d="M5 13l4 4L19 7"></path>
              </svg>
              Copied
            </span>
          </span>
        </button>
        <span id="copied" class="small" role="status" aria-live="polite"></span>
      </div>
    </div>

    <figure class="mail-plate" aria-hidden="true">
      <svg
        viewBox="0 0 480 360"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path
          class="ln"
          pathLength="1"
          d="M20 330 H460"
          style="--k:0"
          stroke-dasharray="2 7"
          opacity="0.5"
        ></path>
        <rect
          class="ln env-back"
          pathLength="1"
          x="60"
          y="130"
          width="360"
          height="200"
          style="--k:1"
        ></rect>
        <path
          class="ln env-open"
          pathLength="1"
          d="M60 130 L240 22 L420 130 Z"
          style="--k:2"
        ></path>
        <g class="letter">
          <rect
            class="ln"
            pathLength="1"
            x="104"
            y="58"
            width="272"
            height="230"
            style="--k:3"
          ></rect>
          <path
            class="ln"
            pathLength="1"
            d="M136 108 H260 M136 140 H344 M136 168 H344 M136 196 H300"
            style="--k:4"
          ></path>
          <circle class="seal" cx="336" cy="104" r="12"></circle>
        </g>
        <path class="env-front" d="M60 130 L240 250 L420 130 V330 H60 Z"></path>
        <path class="ln" pathLength="1" d="M60 330 L204 224 M420 330 L276 224" style="--k:5"></path>
        <path
          class="ln env-front-edge"
          pathLength="1"
          d="M60 130 L240 250 L420 130"
          style="--k:5"
        ></path>
        <path class="env-flap" d="M60 130 L240 250 L420 130 Z"></path>
      </svg>
    </figure>
  </div>

  <ul class="soc" aria-label="Elsewhere">
    {socials.map((so, i) => (
      <li class="soc-i" style={`--i:${i}`}>
        <a
          class="soc-a"
          href={so.url}
          target="_blank"
          rel="me noopener noreferrer"
          aria-label={`${so.label}, @${so.handle} (opens in a new tab)`}
        >
          <span class="soc-top">
            <Icon name={so.icon} class="soc-ico" />
            <svg
              class="soc-arrow"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M7 17 17 7M8 7h9v9" />
            </svg>
          </span>
          <span class="soc-l">{so.label}</span>
          <span class="soc-h">@{so.handle}</span>
        </a>
      </li>
    ))}
  </ul>
</Section>

<script>
  import '../scripts/contact';
</script>
